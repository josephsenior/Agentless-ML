+from __future__ import annotations
+
+import math
+from typing import Any
+
+import pytest
+
+import narwhals as nw
+
+
+def _frame(backend: str, values: list[Any]) -> Any:
+    module = pytest.importorskip(backend)
+    data = {"a": values}
+    if backend == "pandas":
+        native = module.DataFrame(data)
+    elif backend == "pyarrow":
+        native = module.table(data)
+    else:
+        native = module.DataFrame(data)
+    return nw.from_native(native)
+
+
+def _values(series: Any) -> list[Any]:
+    return [
+        None
+        if value is None or (isinstance(value, float) and math.isnan(value))
+        else value
+        for value in series.to_list()
+    ]
+
+
+@pytest.mark.parametrize("backend", ["pandas", "pyarrow", "polars"])
+@pytest.mark.parametrize("center", [False, True])
+@pytest.mark.parametrize(
+    ("method", "extra", "trailing", "centered"),
+    [
+        (
+            "rolling_min",
+            {},
+            [None, None, 1, 3, 2],
+            [None, 1, 3, 2, 2],
+        ),
+        (
+            "rolling_max",
+            {},
+            [None, None, 3, 4, 4],
+            [None, 3, 4, 4, 4],
+        ),
+        (
+            "rolling_median",
+            {},
+            [None, None, 2, 3.5, 3],
+            [None, 2, 3.5, 3, 3],
+        ),
+        (
+            "rolling_quantile",
+            {"quantile": 0.25},
+            [None, None, 1.5, 3.25, 2.5],
+            [None, 1.5, 3.25, 2.5, 2.5],
+        ),
+    ],
+)
+def test_rolling_order_statistics(
+    backend: str,
+    center: bool,
+    method: str,
+    extra: dict[str, Any],
+    trailing: list[Any],
+    centered: list[Any],
+) -> None:
+    frame = _frame(backend, [1, None, 3, 4, 2])
+    kwargs = {
+        "window_size": 3,
+        "min_samples": 2,
+        "center": center,
+        **extra,
+    }
+    expected = centered if center else trailing
+
+    series_result = getattr(frame["a"], method)(**kwargs)
+    expr_result = frame.select(getattr(nw.col("a"), method)(**kwargs))["a"]
+
+    assert _values(series_result) == expected
+    assert _values(expr_result) == expected
+
+
+@pytest.mark.parametrize("backend", ["pandas", "pyarrow", "polars"])
+def test_rolling_order_statistics_defaults_and_even_center(backend: str) -> None:
+    frame = _frame(backend, [1, None, 3, 4, 2])
+
+    assert _values(frame["a"].rolling_min(3)) == [None, None, None, None, 2]
+    assert _values(
+        frame["a"].rolling_median(4, min_samples=2, center=True)
+    ) == [None, 2, 3, 3, 3]
+
+
+@pytest.mark.parametrize("backend", ["pandas", "pyarrow", "polars"])
+@pytest.mark.parametrize(
+    ("quantile", "interpolation", "expected"),
+    [
+        (0.0, "linear", 0),
+        (1.0, "linear", 30),
+        (0.25, "linear", 7.5),
+        (0.25, "lower", 0),
+        (0.25, "higher", 10),
+        (0.25, "nearest", 10),
+        (0.25, "midpoint", 5),
+    ],
+)
+def test_rolling_quantile_interpolation(
+    backend: str,
+    quantile: float,
+    interpolation: str,
+    expected: float,
+) -> None:
+    frame = _frame(backend, [0, 10, 20, 30])
+    kwargs = {"quantile": quantile, "interpolation": interpolation}
+
+    assert _values(frame["a"].rolling_quantile(4, **kwargs)) == [
+        None,
+        None,
+        None,
+        expected,
+    ]
+    assert _values(
+        frame.select(nw.col("a").rolling_quantile(4, **kwargs))["a"]
+    ) == [None, None, None, expected]
+
+
+@pytest.mark.parametrize("kind", ["expr", "series"])
+@pytest.mark.parametrize("quantile", [-0.1, 1.1, float("nan")])
+def test_rolling_quantile_rejects_invalid_quantile(
+    kind: str, quantile: float
+) -> None:
+    target = (
+        nw.col("a") if kind == "expr" else _frame("pandas", [1, 2, 3])["a"]
+    )
+    with pytest.raises(
+        ValueError, match=r"^Quantile must be between 0\.0 and 1\.0"
+    ):
+        target.rolling_quantile(2, quantile=quantile)
+
+
+@pytest.mark.parametrize("kind", ["expr", "series"])
+def test_rolling_quantile_rejects_invalid_interpolation(kind: str) -> None:
+    target = (
+        nw.col("a") if kind == "expr" else _frame("pandas", [1, 2, 3])["a"]
+    )
+    with pytest.raises(ValueError, match="^Interpolation must be one of"):
+        target.rolling_quantile(2, quantile=0.5, interpolation="invalid")
+
+
+@pytest.mark.parametrize(
+    ("method", "extra", "expected"),
+    [
+        ("rolling_min", {}, [None, None, 1, 3, 2]),
+        ("rolling_max", {}, [None, None, 3, 4, 4]),
+        ("rolling_median", {}, [None, None, 2, 3.5, 3]),
+        (
+            "rolling_quantile",
+            {"quantile": 0.25},
+            [None, None, 1.5, 3.25, 2.5],
+        ),
+    ],
+)
+def test_lazy_rolling_order_statistics(
+    method: str, extra: dict[str, Any], expected: list[Any]
+) -> None:
+    frame = _frame("polars", [1, None, 3, 4, 2]).with_row_index("i")
+    expr = getattr(nw.col("a"), method)(3, min_samples=2, **extra)
+    result = frame.lazy().select(expr.over(order_by="i")).collect()
+
+    assert _values(result["a"]) == expected
