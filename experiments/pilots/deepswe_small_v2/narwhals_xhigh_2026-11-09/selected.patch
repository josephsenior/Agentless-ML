+    def _rolling_order_statistic(
+        self,
+        operation: str,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        quantile: float = 0.5,
+        interpolation: str = "linear",
+    ) -> Self:
+        import pyarrow as pa
+        import pyarrow.compute as pc
+
+        values = []
+        length = len(self)
+        offset = (window_size - 1) // 2 if center else 0
+
+        for index in range(length):
+            end = index + offset + 1
+            start = max(0, end - window_size)
+            stop = min(length, end)
+            window = self.native.slice(start, stop - start)
+            sample_count = len(window) - window.null_count
+
+            if sample_count == 0 or sample_count < min_samples:
+                values.append(None)
+            elif operation == "quantile":
+                result = pc.quantile(
+                    window,
+                    q=quantile,
+                    interpolation=interpolation,
+                    skip_nulls=True,
+                )
+                values.append(result[0].as_py())
+            else:
+                result = getattr(pc, operation)(window, skip_nulls=True)
+                values.append(result.as_py())
+
+        result_type = pa.float64() if operation == "quantile" else self.native.type
+        result = pa.chunked_array([pa.array(values, type=result_type)])
+        return self._with_native(result)
