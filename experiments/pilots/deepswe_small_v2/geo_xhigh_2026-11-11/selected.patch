+// shapeIndexStoredShape preserves the Shape interface independently of the
+// concrete Go type that originally supplied the geometry. In particular,
+// reference points and zero-length chains cannot be reconstructed from edges
+// alone.
+type shapeIndexStoredShape struct {
+	dimension int
+	reference ReferencePoint
+	edges     []Edge
+	chains    []Chain
+}
+
+func (s *shapeIndexStoredShape) NumEdges() int {
+	return len(s.edges)
+}
+
+func (s *shapeIndexStoredShape) Edge(edgeID int) Edge {
+	return s.edges[edgeID]
+}
+
+func (s *shapeIndexStoredShape) ReferencePoint() ReferencePoint {
+	return s.reference
+}
+
+func (s *shapeIndexStoredShape) NumChains() int {
+	return len(s.chains)
+}
+
+func (s *shapeIndexStoredShape) Chain(chainID int) Chain {
+	return s.chains[chainID]
+}
+
+func (s *shapeIndexStoredShape) ChainEdge(chainID, offset int) Edge {
+	return s.edges[s.chains[chainID].Start+offset]
+}
+
+func (s *shapeIndexStoredShape) ChainPosition(edgeID int) ChainPosition {
+	// Searching by chain end, rather than start, skips zero-length chains.
+	chainID := sort.Search(len(s.chains), func(i int) bool {
+		return s.chains[i].Start+s.chains[i].Length > edgeID
+	})
+	return ChainPosition{
+		ChainID: chainID,
+		Offset:  edgeID - s.chains[chainID].Start,
+	}
+}
+
+func (s *shapeIndexStoredShape) Dimension() int {
+	return s.dimension
+}
+
+func (s *shapeIndexStoredShape) IsEmpty() bool {
+	return defaultShapeIsEmpty(s)
+}
+
+func (s *shapeIndexStoredShape) IsFull() bool {
+	return defaultShapeIsFull(s)
+}
+
+func (*shapeIndexStoredShape) typeTag() typeTag { return 0 }
+
+func (*shapeIndexStoredShape) privateInterface() {}
+
+var _ Shape = (*shapeIndexStoredShape)(nil)
+
 // A minimal check for types that should satisfy the Shape interface.
 var (
 	_ Shape = &Loop{}
