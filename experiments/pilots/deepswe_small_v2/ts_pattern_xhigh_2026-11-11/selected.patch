+import { Pattern } from './types/Pattern';
+import { MatchEach } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type Step =
+  | {
+      kind: 'with';
+      patterns: readonly Pattern<unknown>[];
+      predicate?: (value: unknown) => unknown;
+      handler: (selections: unknown, value: unknown) => unknown;
+    }
+  | {
+      kind: 'when';
+      predicate: (value: unknown) => unknown;
+      handler: (value: unknown) => unknown;
+    }
+  | {
+      kind: 'tap';
+      callback: (result: unknown) => unknown;
+    };
+
+/**
+ * Evaluates every matching clause and collects its result in declaration order.
+ *
+ * Calling without a value builds a matcher that can be compiled with
+ * `.toFunction()`, `.toExhaustiveFunction()`, or `.toPartialFunction()`.
+ */
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, output>;
+export function matchEach<input, output = symbols.unset>(): MatchEach<
+  input,
+  output
+>;
+export function matchEach(value?: unknown): any {
+  return new MatchEachExpression(value);
+}
+
+/**
+ * Clauses are recorded rather than executed while building the expression.
+ * This also lets compiled functions evaluate the same immutable expression
+ * repeatedly without retaining results or selections from previous calls.
+ */
+class MatchEachExpression {
+  constructor(
+    private readonly input: unknown,
+    private readonly steps: readonly Step[] = []
+  ) {}
+
+  private append(step: Step): MatchEachExpression {
+    return new MatchEachExpression(this.input, [...this.steps, step]);
+  }
+
+  with(...args: any[]): MatchEachExpression {
+    const handler = args[args.length - 1];
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      return this.append({
+        kind: 'with',
+        patterns: [args[0]],
+        predicate: args[1],
+        handler,
+      });
+    }
+
+    return this.append({
+      kind: 'with',
+      patterns: args.slice(0, -1),
+      handler,
+    });
+  }
+
+  when(
+    predicate: (value: unknown) => unknown,
+    handler: (value: unknown) => unknown
+  ): MatchEachExpression {
+    return this.append({ kind: 'when', predicate, handler });
+  }
+
+  tap(callback: (result: unknown) => unknown): MatchEachExpression {
+    return this.append({ kind: 'tap', callback });
+  }
+
+  private evaluate(input: unknown): unknown[] {
+    const results: unknown[] = [];
+
+    for (const step of this.steps) {
+      switch (step.kind) {
+        case 'with': {
+          for (const pattern of step.patterns) {
+            // Each alternative, clause, and evaluation has its own selections.
+            const selected: Record<string, unknown> = {};
+            let hasSelections = false;
+
+            const matched = matchPattern(pattern, input, (key, value) => {
+              hasSelections = true;
+              selected[key] = value;
+            });
+
+            if (!matched) continue;
+            if (step.predicate && !step.predicate(input)) break;
+
+            const selections = hasSelections
+              ? symbols.anonymousSelectKey in selected
+                ? selected[symbols.anonymousSelectKey]
+                : selected
+              : input;
+
+            results.push(step.handler(selections, input));
+
+            // Multiple patterns in one clause are alternatives. The handler
+            // runs once, even when more than one alternative would match.
+            break;
+          }
+          break;
+        }
+
+        case 'when':
+          if (step.predicate(input)) {
+            results.push(step.handler(input));
+          }
+          break;
+
+        case 'tap':
+          for (const result of results) {
+            step.callback(result);
+          }
+          break;
+      }
+    }
+
+    return results;
+  }
+
+  otherwise(handler: (value: unknown) => unknown): unknown[] {
+    const results = this.evaluate(this.input);
+    return results.length === 0 ? [handler(this.input)] : results;
+  }
+
+  exhaustive(
+    handler: (unexpectedValue: unknown) => unknown = defaultCatcher
+  ): unknown[] {
+    return this.otherwise(handler);
+  }
+
+  run(): unknown[] {
+    return this.exhaustive();
+  }
+
+  toFunction(): (input: unknown) => unknown[] {
+    return (input) => {
+      const results = this.evaluate(input);
+      if (results.length === 0) {
+        return defaultCatcher(input);
+      }
+      return results;
+    };
+  }
+
+  toExhaustiveFunction(): (input: unknown) => unknown[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: unknown) => unknown[] | undefined {
+    return (input) => {
+      const results = this.evaluate(input);
+      return results.length === 0 ? undefined : results;
+    };
+  }
+
+  returnType(): this {
+    return this;
+  }
+
+  narrow(): this {
+    return this;
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
