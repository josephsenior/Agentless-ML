+import { Pattern } from './Pattern';
+import { InvertPattern, InvertPatternForExclude } from './InvertPattern';
+import { ExtractPreciseValue } from './ExtractPreciseValue';
+import { FindSelected } from './FindSelected';
+import { DeepExclude } from './DeepExclude';
+import * as symbols from '../internals/symbols';
+
+type PickReturnValue<output, inferred> = output extends symbols.unset
+  ? inferred
+  : output;
+
+type MatchedValue<input, pattern> = [
+  ExtractPreciseValue<input, pattern>
+] extends [never]
+  ? input
+  : ExtractPreciseValue<input, pattern>;
+
+type GuardValue<predicate, input> = predicate extends (
+  value: any
+) => value is infer narrowed
+  ? narrowed
+  : input;
+
+type GuardExcluded<predicate> = predicate extends (
+  value: any
+) => value is infer narrowed
+  ? narrowed
+  : never;
+
+type DeepExcludeAll<input, handled extends readonly unknown[]> = [
+  input
+] extends [never]
+  ? never
+  : handled extends readonly [infer head, ...infer tail]
+  ? DeepExcludeAll<DeepExclude<input, head>, tail>
+  : input;
+
+type NonExhaustiveMatchEach<remaining> = {
+  readonly __nonExhaustive: remaining;
+};
+
+type Exhaustive<output, inferredOutput> = {
+  (): Array<PickReturnValue<output, inferredOutput>>;
+
+  <otherOutput>(
+    handler: (
+      unexpectedValue: unknown
+    ) => PickReturnValue<output, otherOutput>
+  ): Array<PickReturnValue<output, inferredOutput | otherOutput>>;
+};
+
+type AddClause<
+  input,
+  output,
+  handledCases extends readonly unknown[],
+  inferredOutput,
+  remaining,
+  initialInput,
+  clauseOutput,
+  excluded extends readonly unknown[]
+> = MatchEach<
+  input,
+  output,
+  [...handledCases, ...excluded],
+  inferredOutput | clauseOutput,
+  Exclude<remaining, excluded[number]>,
+  initialInput
+>;
+
+/**
+ * `input` is the type accepted by subsequent patterns.
+ * `remaining` and `handledCases` independently track exhaustiveness.
+ * `initialInput` remains the input type of compiled functions.
+ */
+export type MatchEach<
+  input,
+  output = symbols.unset,
+  handledCases extends readonly unknown[] = [],
+  inferredOutput = never,
+  remaining = input,
+  initialInput = input
+> = {
+  with<
+    const pattern extends Pattern<input>,
+    clauseOutput,
+    value extends MatchedValue<input, InvertPattern<pattern, input>>
+  >(
+    pattern: pattern,
+    handler: (
+      selections: FindSelected<value, pattern>,
+      value: value
+    ) => PickReturnValue<output, clauseOutput>
+  ): AddClause<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput,
+    clauseOutput,
+    [InvertPatternForExclude<pattern, value>]
+  >;
+
+  with<
+    const pattern1 extends Pattern<input>,
+    const pattern2 extends Pattern<input>,
+    clauseOutput,
+    pattern extends pattern1 | pattern2,
+    value extends pattern extends any
+      ? MatchedValue<input, InvertPattern<pattern, input>>
+      : never
+  >(
+    pattern1: pattern1,
+    pattern2: pattern2,
+    handler: (value: value) => PickReturnValue<output, clauseOutput>
+  ): AddClause<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput,
+    clauseOutput,
+    [
+      InvertPatternForExclude<pattern1, value>,
+      InvertPatternForExclude<pattern2, value>
+    ]
+  >;
+
+  with<
+    const pattern1 extends Pattern<input>,
+    const pattern2 extends Pattern<input>,
+    const pattern3 extends Pattern<input>,
+    const patterns extends readonly Pattern<input>[],
+    clauseOutput,
+    pattern extends pattern1 | pattern2 | pattern3 | patterns[number],
+    value extends pattern extends any
+      ? MatchedValue<input, InvertPattern<pattern, input>>
+      : never
+  >(
+    ...args: [
+      pattern1: pattern1,
+      pattern2: pattern2,
+      pattern3: pattern3,
+      ...patterns: patterns,
+      handler: (value: value) => PickReturnValue<output, clauseOutput>
+    ]
+  ): AddClause<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput,
+    clauseOutput,
+    [InvertPatternForExclude<pattern, value>]
+  >;
+
+  with<
+    const pattern extends Pattern<input>,
+    predicate extends (
+      value: MatchedValue<input, InvertPattern<pattern, input>>
+    ) => unknown,
+    clauseOutput,
+    value extends GuardValue<
+      predicate,
+      MatchedValue<input, InvertPattern<pattern, input>>
+    >
+  >(
+    pattern: pattern,
+    predicate: predicate,
+    handler: (
+      selections: FindSelected<value, pattern>,
+      value: value
+    ) => PickReturnValue<output, clauseOutput>
+  ): AddClause<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput,
+    clauseOutput,
+    [GuardExcluded<predicate>]
+  >;
+
+  when<predicate extends (value: input) => unknown, clauseOutput>(
+    predicate: predicate,
+    handler: (
+      value: GuardValue<predicate, input>
+    ) => PickReturnValue<output, clauseOutput>
+  ): AddClause<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput,
+    clauseOutput,
+    [GuardExcluded<predicate>]
+  >;
+
+  tap(
+    callback: (result: PickReturnValue<output, inferredOutput>) => unknown
+  ): MatchEach<
+    input,
+    output,
+    handledCases,
+    inferredOutput,
+    remaining,
+    initialInput
+  >;
+
+  otherwise<otherOutput>(
+    handler: (value: remaining) => PickReturnValue<output, otherOutput>
+  ): Array<PickReturnValue<output, inferredOutput | otherOutput>>;
+
+  exhaustive: DeepExcludeAll<remaining, handledCases> extends infer rest
+    ? [rest] extends [never]
+      ? Exhaustive<output, inferredOutput>
+      : NonExhaustiveMatchEach<rest>
+    : never;
+
+  run(): Array<PickReturnValue<output, inferredOutput>>;
+
+  toFunction(): (
+    input: initialInput
+  ) => Array<PickReturnValue<output, inferredOutput>>;
+
+  toExhaustiveFunction: DeepExcludeAll<
+    remaining,
+    handledCases
+  > extends infer rest
+    ? [rest] extends [never]
+      ? () => (
+          input: initialInput
+        ) => Array<PickReturnValue<output, inferredOutput>>
+      : NonExhaustiveMatchEach<rest>
+    : never;
+
+  toPartialFunction(): (
+    input: initialInput
+  ) => Array<PickReturnValue<output, inferredOutput>> | undefined;
+
+  returnType: [inferredOutput] extends [never]
+    ? <newOutput>() => MatchEach<
+        input,
+        newOutput,
+        handledCases,
+        never,
+        remaining,
+        initialInput
+      >
+    : {
+        readonly __error: 'calling `.returnType<T>()` is only allowed at the beginning of your expression.';
+      };
+
+  narrow(): MatchEach<
+    DeepExcludeAll<remaining, handledCases>,
+    output,
+    [],
+    inferredOutput,
+    DeepExcludeAll<remaining, handledCases>,
+    initialInput
+  >;
+};
