+import { matchEach, NonExhaustiveError, P } from '../src';
+
+describe('matchEach', () => {
+  it('collects every matching clause in declaration order', () => {
+    const results = matchEach<number>(2)
+      .with(P.number, (value) => `number:${value}`)
+      .with(1, 2, (value) => `two alternatives:${value}`)
+      .with(1, 2, 3, 4, (value) => `four alternatives:${value}`)
+      .with(
+        P.select('number'),
+        (value) => value > 0,
+        ({ number }) => `guard:${number}`
+      )
+      .when(
+        (value) => value % 2 === 0,
+        (value) => `even:${value}`
+      )
+      .exhaustive();
+
+    expect(results).toEqual([
+      'number:2',
+      'two alternatives:2',
+      'four alternatives:2',
+      'guard:2',
+      'even:2',
+    ]);
+  });
+
+  it('runs a multi-pattern clause only once', () => {
+    expect(
+      matchEach<number>(2)
+        .with(P.number, 2, () => 'matched')
+        .run()
+    ).toEqual(['matched']);
+  });
+
+  it('throws when run finds no matching clause', () => {
+    expect(() =>
+      matchEach<'a' | 'b'>('b')
+        .with('a', () => 1)
+        .run()
+    ).toThrow(NonExhaustiveError);
+  });
+
+  it('uses otherwise only when no clause matched', () => {
+    let fallbackCalls = 0;
+    const fallback = () => {
+      fallbackCalls += 1;
+      return 3;
+    };
+
+    expect(
+      matchEach<'a' | 'b'>('a')
+        .with('a', () => 1)
+        .with('a', () => 2)
+        .otherwise(fallback)
+    ).toEqual([1, 2]);
+    expect(fallbackCalls).toBe(0);
+
+    expect(
+      matchEach<'a' | 'b'>('b')
+        .with('a', () => 1)
+        .otherwise(fallback)
+    ).toEqual([3]);
+    expect(fallbackCalls).toBe(1);
+
+    expect(matchEach(0).otherwise((value) => value)).toEqual([0]);
+  });
+
+  it('supports exhaustive fallbacks for unexpected runtime values', () => {
+    const rejectsEveryString = (value: string): value is string => false;
+
+    const expression = matchEach<string>('unexpected').when(
+      rejectsEveryString,
+      () => 1
+    );
+
+    expect(() => expression.exhaustive()).toThrow(NonExhaustiveError);
+    expect(
+      expression.exhaustive((value) => {
+        expect(value).toBe('unexpected');
+        return 2;
+      })
+    ).toEqual([2]);
+  });
+
+  it('does not call an exhaustive fallback after a match', () => {
+    let fallbackCalls = 0;
+
+    expect(
+      matchEach<number>(1)
+        .with(P.number, () => 1)
+        .with(P._, () => 2)
+        .exhaustive(() => {
+          fallbackCalls += 1;
+          return 3;
+        })
+    ).toEqual([1, 2]);
+
+    expect(fallbackCalls).toBe(0);
+  });
+
+  it('executes each tap for the results collected at that point', () => {
+    const events: string[] = [];
+
+    const expression = matchEach<number>(2)
+      .with(P.number, (value) => value)
+      .tap((result) => events.push(`first:${result}`))
+      .tap((result) => events.push(`stacked:${result}`))
+      .with(2, () => 20)
+      .tap((result) => events.push(`second:${result}`))
+      .when(() => true, () => 30);
+
+    expect(events).toEqual([]);
+    expect(expression.run()).toEqual([2, 20, 30]);
+    expect(events).toEqual([
+      'first:2',
+      'stacked:2',
+      'second:2',
+      'second:20',
+    ]);
+  });
+
+  it('returns a new expression from tap', () => {
+    const events: number[] = [];
+    const base = matchEach<number>(1).with(P.number, (value) => value);
+    const tapped = base.tap((result) => events.push(result));
+
+    expect(base.run()).toEqual([1]);
+    expect(events).toEqual([]);
+
+    expect(tapped.run()).toEqual([1]);
+    expect(events).toEqual([1]);
+  });
+
+  it('does not tap an otherwise result', () => {
+    const events: number[] = [];
+
+    expect(
+      matchEach<'a' | 'b'>('b')
+        .with('a', () => 1)
+        .tap((result) => events.push(result))
+        .otherwise(() => 2)
+    ).toEqual([2]);
+
+    expect(events).toEqual([]);
+  });
+
+  it('keeps named selections independent between clauses', () => {
+    expect(
+      matchEach({ left: 1, right: 2 })
+        .with({ left: P.select('left') }, (selected) => selected)
+        .with({ right: P.select('right') }, (selected) => selected)
+        .run()
+    ).toEqual([{ left: 1 }, { right: 2 }]);
+  });
+
+  it('discards selections from failed alternatives', () => {
+    expect(
+      matchEach({ value: 1, valid: true })
+        .with(
+          { value: P.select('discarded'), valid: false },
+          { value: P.select('kept') },
+          (selected) => selected
+        )
+        .run()
+    ).toEqual([{ kept: 1 }]);
+  });
+
+  it('compiles throwing and partial matchers', () => {
+    const expression = matchEach<'a' | 'b'>().with('a', () => 1);
+    const run = expression.toFunction();
+    const partial = expression.toPartialFunction();
+
+    expect(run('a')).toEqual([1]);
+    expect(() => run('b')).toThrow(NonExhaustiveError);
+    expect(partial('a')).toEqual([1]);
+    expect(partial('b')).toBeUndefined();
+
+    expect(matchEach<number>().toPartialFunction()(0)).toBeUndefined();
+  });
+
+  it('keeps selections independent across all compiled function variants', () => {
+    const expression = matchEach<{ left: number; right: number }>()
+      .with({ left: P.select('left') }, (selected) => selected)
+      .with({ right: P.select('right') }, (selected) => selected);
+
+    const functions = [
+      expression.toFunction(),
+      expression.toExhaustiveFunction(),
+      expression.toPartialFunction(),
+    ];
+
+    for (const compiled of functions) {
+      expect(compiled({ left: 1, right: 2 })).toEqual([
+        { left: 1 },
+        { right: 2 },
+      ]);
+      expect(compiled({ left: 3, right: 4 })).toEqual([
+        { left: 3 },
+        { right: 4 },
+      ]);
+    }
+  });
+
+  it('executes taps and resets array selections in compiled functions', () => {
+    const events: number[][] = [];
+    const expression = matchEach<{ values: number[] }>()
+      .with({ values: P.array(P.select()) }, (values) => values)
+      .tap((result) => events.push([...result]))
+      .with({ values: P.select() }, (values) => values)
+      .tap((result) => events.push([...result]));
+
+    const functions = [
+      expression.toFunction(),
+      expression.toExhaustiveFunction(),
+      expression.toPartialFunction(),
+    ];
+
+    for (const compiled of functions) {
+      events.length = 0;
+
+      expect(compiled({ values: [1, 2] })).toEqual([[1, 2], [1, 2]]);
+      expect(compiled({ values: [3] })).toEqual([[3], [3]]);
+      expect(events).toEqual([
+        [1, 2],
+        [1, 2],
+        [1, 2],
+        [3],
+        [3],
+        [3],
+      ]);
+    }
+  });
+
+  it('preserves the builder type guarantees', () => {
+    // Type-check these expressions without evaluating intentionally invalid
+    // terminal calls or clauses.
+    const checkTypes = (
+      input: 'a' | 'b',
+      nested: { kind: 'a' | 'b' }
+    ) => {
+      const incomplete = matchEach(input).with('a', () => 1);
+
+      // @ts-expect-error The 'b' case has not been handled.
+      incomplete.exhaustive();
+
+      // @ts-expect-error The 'b' case has not been handled.
+      incomplete.exhaustive(() => 0);
+
+      // @ts-expect-error The 'b' case has not been handled.
+      incomplete.toExhaustiveFunction();
+
+      const complete = incomplete
+        .with('a', () => 2)
+        .with('b', () => 3);
+
+      const results: number[] = complete.exhaustive();
+      const compiled: (input: 'a' | 'b') => number[] =
+        complete.toExhaustiveFunction();
+      const partial: (input: 'a' | 'b') => number[] | undefined =
+        incomplete.toPartialFunction();
+
+      void results;
+      void compiled;
+      void partial;
+
+      const narrowed = incomplete.narrow();
+      narrowed.with('b', (value) => {
+        const b: 'b' = value;
+        return b;
+      });
+
+      // @ts-expect-error Explicit narrowing excludes previously handled cases.
+      narrowed.with('a', () => 0);
+
+      const deeplyNarrowed = matchEach(nested)
+        .with({ kind: 'a' }, () => 1)
+        .narrow();
+
+      // @ts-expect-error Explicit narrowing also excludes nested cases.
+      deeplyNarrowed.with({ kind: 'a' }, () => 0);
+
+      deeplyNarrowed.with({ kind: 'b' }, () => 2).exhaustive();
+
+      const typed = matchEach(input).returnType<number>();
+
+      // @ts-expect-error Handlers must return the explicit output type.
+      typed.with('a', () => 'not a number');
+
+      const typedResults: number[] = typed
+        .with('a', () => 1)
+        .with('b', () => 2)
+        .exhaustive();
+
+      void typedResults;
+
+      // @ts-expect-error returnType must precede result-producing clauses.
+      incomplete.returnType<number>();
+
+      const guarded = matchEach(input).with(
+        P._,
+        (value): value is 'a' => value === 'a',
+        (value) => {
+          const a: 'a' = value;
+          return a.length;
+        }
+      );
+
+      // Guarded handling must not remove 'a' from subsequent pattern inputs.
+      guarded.with('a', () => 1).with('b', () => 2).exhaustive();
+
+      const booleanGuard = matchEach(input).when(
+        () => true,
+        (value) => {
+          const original: 'a' | 'b' = value;
+          return original.length;
+        }
+      );
+
+      // @ts-expect-error A boolean predicate does not prove exhaustiveness.
+      booleanGuard.exhaustive();
+
+      matchEach(input)
+        .when(
+          (value): value is 'a' => value === 'a',
+          () => 1
+        )
+        .when(
+          (value): value is 'b' => value === 'b',
+          () => 2
+        )
+        .toExhaustiveFunction();
+    };
+
+    void checkTypes;
+  });
+});
