+++ b/packages/core/src/aspect/query-result.ts
@@ -0,0 +1,198 @@
+import type { Entity } from '../entity/types';
+import { createQueryResult } from '../query/query-result';
+import type {
+    InstancesFromParameters,
+    QueryInstance,
+    QueryParameter,
+    QueryResult,
+    QueryResultOptions,
+    StoresFromParameters,
+} from '../query/types';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { getAspectData, isAspect } from './aspect';
+
+interface Selection {
+    index?: number;
+    fields?: [string, number][];
+}
+
+/**
+ * Expose an AoS field as a column when an aspect store combines AoS and SoA
+ * constituents. Like ordinary useStores, these accesses do not detect changes.
+ */
+function getColumn(store: any, field: string): any {
+    if (!Array.isArray(store)) return store[field];
+
+    return new Proxy([], {
+        get(target, property, receiver) {
+            if (property === 'length') return store.length;
+
+            if (typeof property === 'string' && /^(0|[1-9]\d*)$/.test(property)) {
+                return store[Number(property)]?.[field];
+            }
+
+            return Reflect.get(target, property, receiver);
+        },
+
+        set(target, property, value, receiver) {
+            if (typeof property === 'string' && /^(0|[1-9]\d*)$/.test(property)) {
+                const index = Number(property);
+                if (!store[index]) store[index] = {};
+                store[index][field] = value;
+                return true;
+            }
+
+            return Reflect.set(target, property, value, receiver);
+        },
+    });
+}
+
+export function createAspectQueryResult<T extends QueryParameter[]>(
+    world: World,
+    entities: Entity[],
+    query: QueryInstance,
+    selectedTraits: Trait[]
+): QueryResult<T> {
+    const dataTraits: Trait[] = [];
+    const indices = new Map<Trait, number>();
+
+    function include(trait: Trait): number {
+        const existing = indices.get(trait);
+        if (existing !== undefined) return existing;
+
+        const index = dataTraits.length;
+        indices.set(trait, index);
+        dataTraits.push(trait);
+        return index;
+    }
+
+    const selections: Selection[] = selectedTraits.map((selected) => {
+        if (!isAspect(selected)) return { index: include(selected) };
+
+        const fields: [string, number][] = [];
+        for (const [field, owner] of getAspectData(selected).fields) {
+            fields.push([field, include(owner)]);
+        }
+        return { fields };
+    });
+
+    // Constituents are flattened at creation, so this cannot recurse into the
+    // aspect-result path. Shared constituents use the same callback snapshot.
+    const result = createQueryResult<QueryParameter[]>(world, entities, query, dataTraits);
+    const readEach = result.readEach.bind(result);
+    const updateEach = result.updateEach.bind(result);
+    const useStores = result.useStores.bind(result);
+
+    function mergeState(state: any[], writable: boolean): any[] {
+        return selections.map((selection) => {
+            if (selection.index !== undefined) return state[selection.index];
+
+            const merged: Record<string, any> = {};
+
+            for (const [field, index] of selection.fields!) {
+                const snapshot = state[index];
+
+                Object.defineProperty(
+                    merged,
+                    field,
+                    writable
+                        ? {
+                              enumerable: true,
+                              configurable: true,
+                              get: () => snapshot[field],
+                              set: (value) => {
+                                  snapshot[field] = value;
+                              },
+                          }
+                        : {
+                              enumerable: true,
+                              configurable: true,
+                              writable: true,
+                              value: snapshot[field],
+                          }
+                );
+            }
+
+            return merged;
+        });
+    }
+
+    return Object.assign(result, {
+        readEach(
+            callback: (state: InstancesFromParameters<T>, entity: Entity, index: number) => void
+        ) {
+            readEach((state, entity, index) => {
+                callback(
+                    mergeState(state, false) as InstancesFromParameters<T>,
+                    entity,
+                    index
+                );
+            });
+
+            return result as unknown as QueryResult<T>;
+        },
+
+        updateEach(
+            callback: (state: InstancesFromParameters<T>, entity: Entity, index: number) => void,
+            options: QueryResultOptions = { changeDetection: 'auto' }
+        ) {
+            updateEach((state, entity, index) => {
+                const merged = mergeState(state, true);
+                const original = [...merged];
+
+                callback(merged as InstancesFromParameters<T>, entity, index);
+
+                // Also support replacing a callback slot instead of mutating
+                // the object supplied in that slot.
+                for (let i = 0; i < selections.length; i++) {
+                    if (merged[i] === original[i]) continue;
+
+                    const selection = selections[i];
+
+                    if (selection.index !== undefined) {
+                        state[selection.index] = merged[i];
+                        continue;
+                    }
+
+                    if (!merged[i]) continue;
+
+                    for (const [field, ownerIndex] of selection.fields!) {
+                        if (Object.prototype.hasOwnProperty.call(merged[i], field)) {
+                            state[ownerIndex][field] = merged[i][field];
+                        }
+                    }
+                }
+            }, options);
+
+            return result as unknown as QueryResult<T>;
+        },
+
+        useStores(callback: (stores: StoresFromParameters<T>, entities: readonly Entity[]) => void) {
+            useStores((stores, matchingEntities) => {
+                const merged = selections.map((selection) => {
+                    if (selection.index !== undefined) return stores[selection.index];
+
+                    const store: Record<string, any> = {};
+                    for (const [field, index] of selection.fields!) {
+                        Object.defineProperty(store, field, {
+                            value: getColumn(stores[index], field),
+                            enumerable: true,
+                            configurable: true,
+                            writable: true,
+                        });
+                    }
+                    return store;
+                });
+
+                callback(merged as StoresFromParameters<T>, matchingEntities);
+            });
+
+            return result as unknown as QueryResult<T>;
+        },
+
+        select<U extends QueryParameter[]>(...params: U): QueryResult<U> {
+            return createQueryResult<U>(world, entities, query, params);
+        },
+    }) as unknown as QueryResult<T>;
+}
