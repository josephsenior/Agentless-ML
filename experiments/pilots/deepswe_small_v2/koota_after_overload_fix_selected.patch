+
+        entity.set(A, { a: 1 });
+        expect(world.query(Changed(AB))).toContain(entity);
+
+        entity.remove(A);
+        expect(world.query(Removed(AB))).toContain(entity);
+
+        world.destroy();
+    });
+
+    it('fires hooks only for completeness transitions and complete changes', () => {
+        const world = createWorld();
