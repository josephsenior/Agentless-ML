+        const B = trait({ b: 0 });
+        const AB = createAspect(A, B);
+        const events: string[] = [];
+
+        const unsubscribeAdd = world.onAdd(AB, () => events.push('add'));
+        const unsubscribeRemove = world.onRemove(AB, () => events.push('remove'));
+        const unsubscribeChange = world.onChange(AB, () => events.push('change'));
+
+        const entity = world.spawn(A);
+        entity.set(A, { a: 1 });
+        expect(events).toEqual([]);
+
+        entity.add(B);
+        entity.set(A, { a: 2 });
+        entity.remove(B);
+        entity.set(A, { a: 3 });
+
+        expect(events).toEqual(['add', 'change', 'remove']);
+
+        unsubscribeAdd();
+        unsubscribeRemove();
+        unsubscribeChange();
+        world.destroy();
+    });
+});
