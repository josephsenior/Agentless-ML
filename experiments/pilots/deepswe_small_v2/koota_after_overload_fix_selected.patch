+        const ActiveMotion = createAspect(Motion, Active);
+
+        expect(ActiveMotion.traits).toEqual([Position, Velocity, Active]);
+        expect(ActiveMotion.schema).toEqual({ x: 0, speed: 0 });
+        expect(createAspect(Position, Velocity)).not.toBe(Motion);
+        expect(createAspect(Position, Velocity).id).not.toBe(Motion.id);
+    });
+
+    it('rejects overlapping fields and relation constituents', () => {
+        const Position = trait({ x: 0 });
+        const OtherPosition = trait({ x: 1 });
+        const Parent = relation();
+
+        expect(() => createAspect(Position, OtherPosition)).toThrow(/overlapping/);
+        expect(() => createAspect(Position, Parent as any)).toThrow(/relations/);
+        expect(() => (createAspect as any)(Position)).toThrow(/at least two/);
+    });
+
+    it('adds only missing constituents and distributes get, set, and remove', () => {
+        const world = createWorld();
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ speed: 0 });
+        const Motion = createAspect(Position, Velocity);
+        const entity = world.spawn(Position({ x: 10 }));
+
+        expect(entity.has(Motion)).toBe(false);
+        expect(entity.get(Motion)).toBeUndefined();
+
+        entity.add(Motion({ x: 100, speed: 20 }));
+
+        expect(entity.get(Position)).toEqual({ x: 10 });
+        expect(entity.get(Velocity)).toEqual({ speed: 20 });
+        expect(entity.get(Motion)).toEqual({ x: 10, speed: 20 });
+
+        entity.set(Motion, { x: 30, speed: 40 });
+
+        expect(entity.get(Position)).toEqual({ x: 30 });
+        expect(entity.get(Velocity)).toEqual({ speed: 40 });
+
+        entity.remove(Motion);
+
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.get(Motion)).toBeUndefined();
+
+        world.destroy();
+    });
+
+    it('supports world-level operations and aspects created after entities', () => {
