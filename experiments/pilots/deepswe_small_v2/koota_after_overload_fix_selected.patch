@@ -0,0 +1,410 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { $relation, $relationPair } from '../relation/symbols';
+import { trait } from '../trait/trait';
+import type { ConfigurableTrait, ExtractSchema, Trait } from '../trait/types';
+import { universe } from '../universe/universe';
+import type { World } from '../world';
+
+type UnionToIntersection<T> = (
+    T extends unknown ? (value: T) => void : never
+) extends (value: infer I) => void
+    ? I
+    : never;
+
+type ConstituentSchema<T extends readonly Trait[]> = UnionToIntersection<
+    NonNullable<ExtractSchema<T[number]>>
+>;
+
+type AspectSchema<T extends readonly Trait[]> = {
+    [K in keyof ConstituentSchema<T>]: ConstituentSchema<T>[K];
+};
+
+export type Aspect<T extends readonly Trait[] = readonly Trait[]> = ReturnType<
+    typeof trait<AspectSchema<T>>
+> & {
+    readonly id: number;
+    readonly traits: readonly Trait[];
+    readonly schema: AspectSchema<T>;
+};
+
+interface AspectData {
+    aspect: Aspect;
+    traits: readonly Trait[];
+    schema: Record<string, any>;
+    fields: Map<string, Trait>;
+}
+
+interface ConfiguredAspect {
+    data: AspectData;
+    values: Record<string, any>;
+}
+
+type EntityMethodName = 'has' | 'get' | 'set' | 'add' | 'remove';
+type EntityMethod = (this: number, ...args: any[]) => any;
+
+const revisionField = '__kootaAspectRevision';
+const aspects = new Map<Trait, AspectData>();
+const configurations = new WeakMap<object, ConfiguredAspect>();
+const initializedWorlds = new WeakMap<World, Map<AspectData, (() => unknown)[]>>();
+const nativeMethods = {} as Record<EntityMethodName, EntityMethod>;
+let entityMethodsInstalled = false;
+
+function callEntity(method: EntityMethodName, entity: Entity, ...args: any[]): any {
+    return Reflect.apply(nativeMethods[method], entity, args);
+}
+
+export function isAspect(value: unknown): value is Aspect {
+    return typeof value === 'function' && aspects.has(value as Trait);
+}
+
+export function getAspectData(aspect: Aspect): AspectData {
+    return aspects.get(aspect)!;
+}
+
+function getConfiguredAspect(value: ConfigurableTrait): ConfiguredAspect | undefined {
+    if (isAspect(value)) {
+        return { data: getAspectData(value), values: {} };
+    }
+
+    if (value !== null && (typeof value === 'object' || typeof value === 'function')) {
+        return configurations.get(value as object);
+    }
+
+    return undefined;
+}
+
+function getSchema(value: Trait): Record<string, any> {
+    const internal = (value as any)[$internal];
+    return (value as any).schema ?? internal.schema ?? {};
+}
+
+/**
+ * Creates a distinct aspect. The membership trait is deliberately separate from
+ * the constituent data: aspect writes must always reach the original stores.
+ */
+export function createAspect<T extends [Trait, Trait, ...Trait[]]>(...inputs: T): Aspect<T> {
+    if (inputs.length < 2) {
+        throw new Error('createAspect requires at least two traits');
+    }
+
+    const flattened: Trait[] = [];
+
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            flattened.push(...input.traits);
+            continue;
+        }
+
+        const internal = (input as any)?.[$internal];
+
+        if (
+            typeof input !== 'function' ||
+            !internal ||
+            (input as any)[$relation] ||
+            (input as any)[$relationPair] ||
+            internal.relation ||
+            internal.isRelation
+        ) {
+            throw new Error('Aspect constituents must be traits, not relations');
+        }
+
+        flattened.push(input);
+    }
+
+    const schema: Record<string, any> = {};
+    const fields = new Map<string, Trait>();
+
+    for (const constituent of flattened) {
+        const constituentSchema = getSchema(constituent);
+
+        for (const field of Object.keys(constituentSchema)) {
+            if (fields.has(field)) {
+                throw new Error(`Aspect constituents have overlapping field "${field}"`);
+            }
+
+            fields.set(field, constituent);
+            Object.defineProperty(schema, field, {
+                value: constituentSchema[field],
+                enumerable: true,
+                configurable: true,
+                writable: true,
+            });
+        }
+    }
+
+    const members = Object.freeze([...new Set(flattened)]);
+    Object.freeze(schema);
+
+    // A data-bearing membership trait also makes all-tag aspects selectable.
+    const membership = trait({ [revisionField]: 0 });
+    const id = (membership as any).id ?? (membership as any)[$internal].id;
+    let data: AspectData;
+
+    const aspect = new Proxy(membership, {
+        get(target, property, receiver) {
+            if (property === 'id') return id;
+            if (property === 'traits') return members;
+            if (property === 'schema') return schema;
+            return Reflect.get(target, property, receiver);
+        },
+
+        apply(target, receiver, args) {
+            const configured = Reflect.apply(target, receiver, args);
+            configurations.set(configured as object, {
+                data,
+                values: args[0] ?? {},
+            });
+            return configured;
+        },
+    }) as unknown as Aspect;
+
+    data = { aspect, traits: members, schema, fields };
+    aspects.set(aspect, data);
+
+    // Aspects can be defined after a world already contains entities.
+    for (const world of universe.worlds) {
+        if (world) initializeAspect(world, data);
+    }
+
+    return aspect as Aspect<T>;
+}
+
+export function hasAspect(entity: Entity, aspect: Aspect): boolean {
+    return aspect.traits.every((constituent) => callEntity('has', entity, constituent));
+}
+
+export function getAspectValue(
+    entity: Entity,
+    aspect: Aspect
+): Record<string, any> | undefined {
+    if (!hasAspect(entity, aspect)) return undefined;
+
+    const value: Record<string, any> = {};
+    for (const constituent of aspect.traits) {
+        Object.assign(value, callEntity('get', entity, constituent));
+    }
+    return value;
+}
+
+export function setAspectValue(
+    entity: Entity,
+    aspect: Aspect,
+    value: unknown,
+    ...options: any[]
+): void {
+    const current = getAspectValue(entity, aspect);
+    if (current === undefined) return;
+
+    let values = value as Record<string, any>;
+
+    if (typeof value === 'function') {
+        values = value(current) ?? current;
+    }
+
+    if (!values) return;
+
+    const updates = new Map<Trait, Record<string, any>>();
+    const { fields } = getAspectData(aspect);
+
+    for (const field of Object.keys(values)) {
+        const owner = fields.get(field);
+        if (!owner) continue;
+
+        let update = updates.get(owner);
+        if (!update) {
+            update = {};
+            updates.set(owner, update);
+        }
+
+        Object.defineProperty(update, field, {
+            value: values[field],
+            enumerable: true,
+            configurable: true,
+            writable: true,
+        });
+    }
+
+    for (const [constituent, update] of updates) {
+        callEntity('set', entity, constituent, update, ...options);
+    }
+}
+
+export function addAspectTraits(
+    entity: Entity,
+    inputs: readonly ConfigurableTrait[],
+    add: (...traits: ConfigurableTrait[]) => void
+): void {
+    if (!inputs.some((input) => getConfiguredAspect(input))) {
+        add(...inputs);
+        return;
+    }
+
+    for (const input of inputs) {
+        const configured = getConfiguredAspect(input);
+
+        if (!configured) {
+            add(input);
+            continue;
+        }
+
+        const { data, values } = configured;
+
+        for (const constituent of data.traits) {
+            if (callEntity('has', entity, constituent)) continue;
+
+            const initial: Record<string, any> = {};
+
+            for (const [field, owner] of data.fields) {
+                if (
+                    owner === constituent &&
+                    Object.prototype.hasOwnProperty.call(values, field)
+                ) {
+                    Object.defineProperty(initial, field, {
+                        value: values[field],
+                        enumerable: true,
+                        configurable: true,
+                        writable: true,
+                    });
+                }
+            }
+
+            add(Object.keys(initial).length ? constituent(initial) : constituent);
+        }
+    }
+}
+
+export function expandAspectRemovals(inputs: readonly Trait[]): Trait[] {
+    const result = new Set<Trait>();
+
+    for (const input of inputs) {
+        if (isAspect(input)) {
+            for (const constituent of input.traits) result.add(constituent);
+        } else {
+            result.add(input);
+        }
+    }
+
+    return [...result];
+}
+
+function initializeAspect(world: World, data: AspectData): void {
+    let initialized = initializedWorlds.get(world);
+
+    if (!initialized) {
+        initialized = new Map();
+        initializedWorlds.set(world, initialized);
+    }
+
+    if (initialized.has(data)) return;
+
+    const subscriptions: (() => unknown)[] = [];
+    initialized.set(data, subscriptions);
+
+    const { aspect, traits } = data;
+    let revision = 0;
+
+    function synchronize(entity: Entity, changing?: Trait, present?: boolean) {
+        const complete = traits.every((constituent) =>
+            constituent === changing
+                ? present
+                : callEntity('has', entity, constituent)
+        );
+        const hadAspect = callEntity('has', entity, aspect);
+
+        if (complete && !hadAspect) {
+            callEntity('add', entity, aspect);
+        } else if (!complete && hadAspect) {
+            callEntity('remove', entity, aspect);
+        }
+    }
+
+    for (const constituent of traits) {
+        subscriptions.push(
+            world.onAdd(constituent, (entity) => synchronize(entity, constituent, true)),
+            world.onRemove(constituent, (entity) => synchronize(entity, constituent, false)),
+            world.onChange(constituent, (entity) => {
+                if (hasAspect(entity, aspect) && callEntity('has', entity, aspect)) {
+                    callEntity(
+                        'set',
+                        entity,
+                        aspect,
+                        { [revisionField]: ++revision },
+                        true
+                    );
+                }
+            })
+        );
+    }
+
+    for (const entity of world.entities) synchronize(entity);
+}
+
+export function initializeAspectWorld(world: World): void {
+    for (const data of aspects.values()) initializeAspect(world, data);
+}
+
+export function disposeAspectWorld(world: World): void {
+    const initialized = initializedWorlds.get(world);
+    if (!initialized) return;
+
+    for (const subscriptions of initialized.values()) {
+        for (const unsubscribe of subscriptions) unsubscribe();
+    }
+
+    initializedWorlds.delete(world);
+}
+
+/**
+ * Extend the existing entity-method patch while retaining the native operations
+ * for membership maintenance. Internal membership writes must not expand again.
+ */
+export function installAspectEntityMethods(): void {
+    if (entityMethodsInstalled) return;
+    entityMethodsInstalled = true;
+
+    const prototype = Number.prototype as unknown as Record<EntityMethodName, EntityMethod>;
+    const names: EntityMethodName[] = ['has', 'get', 'set', 'add', 'remove'];
+
+    for (const name of names) nativeMethods[name] = prototype[name];
+
+    for (const name of names) {
+        const descriptor = Object.getOwnPropertyDescriptor(prototype, name);
+
+        Object.defineProperty(prototype, name, {
+            ...descriptor,
+            value: function (this: number, ...args: any[]) {
+                const entity = Number(this) as Entity;
+
+                if (name === 'has' && isAspect(args[0])) {
+                    return hasAspect(entity, args[0]);
+                }
+
+                if (name === 'get' && isAspect(args[0])) {
+                    return getAspectValue(entity, args[0]);
+                }
+
+                if (name === 'set' && isAspect(args[0])) {
+                    setAspectValue(entity, args[0], args[1], ...args.slice(2));
+                    return entity;
+                }
+
+                if (
+                    name === 'add' &&
+                    args.some((input) => getConfiguredAspect(input))
+                ) {
+                    addAspectTraits(entity, args, (...traits) => {
+                        callEntity('add', entity, ...traits);
+                    });
+                    return entity;
+                }
+
+                if (name === 'remove' && args.some(isAspect)) {
+                    return callEntity('remove', entity, ...expandAspectRemovals(args));
+                }
+
+                return callEntity(name, entity, ...args);
+            },
+        });
+    }
+}
