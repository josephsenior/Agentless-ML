+++ b/tests/test_incremental_cache.py
@@ -0,0 +1,191 @@
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from vulture import cache
+from vulture.core import Vulture
+
+
+def run_cached(root, cache_dir, **kwargs):
+    analyzer = Vulture(cache_dir=cache_dir, **kwargs)
+    analyzer.scavenge([root])
+    return analyzer
+
+
+def normalized(*paths):
+    return {cache.normalize_path(path) for path in paths}
+
+
+def test_reuse_and_transitive_invalidation(tmp_path):
+    source = tmp_path / "source"
+    source.mkdir()
+    a = source / "a.py"
+    b = source / "b.py"
+    c = source / "c.py"
+    other = source / "other.py"
+    a.write_text("def function_a(): pass\n", encoding="utf-8")
+    b.write_text("from a import function_a\n", encoding="utf-8")
+    c.write_text("import b\n", encoding="utf-8")
+    other.write_text("other_value = 1\n", encoding="utf-8")
+    directory = tmp_path / "cache"
+
+    first = run_cached(source, directory)
+    assert first._cache_stats == {
+        "scanned": normalized(a, b, c, other),
+        "reused": set(),
+    }
+
+    second = run_cached(source, directory)
+    assert second._cache_stats == {
+        "scanned": set(),
+        "reused": normalized(a, b, c, other),
+    }
+
+    a.write_text("def function_a(): return 42\n", encoding="utf-8")
+    third = run_cached(source, directory)
+    assert third._cache_stats == {
+        "scanned": normalized(a, b, c),
+        "reused": normalized(other),
+    }
+
+
+def test_first_save_writes_backup_and_verified_metadata(tmp_path, capsys):
+    source = tmp_path / "module.py"
+    source.write_text("value = 1\n", encoding="utf-8")
+    directory = tmp_path / "cache"
+    run_cached(source, directory)
+
+    path = cache.get_cache_path(directory)
+    contents = path.read_bytes()
+    assert path.with_name("cache.json.bak").read_bytes() == contents
+    metadata = json.loads(path.with_name("cache.json.meta").read_bytes())
+    assert metadata == {
+        "sha256": hashlib.sha256(contents).hexdigest()
+    }
+
+    # Still valid JSON, but no longer the contents covered by the checksum.
+    path.write_bytes(contents + b"\n")
+    analyzer = run_cached(source, directory)
+    assert analyzer._cache_stats["scanned"] == normalized(source)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+def test_runtime_and_settings_invalidation(tmp_path, monkeypatch):
+    source = tmp_path / "module.py"
+    source.write_text("value = 1\n", encoding="utf-8")
+    directory = tmp_path / "cache"
+    run_cached(source, directory)
+
+    monkeypatch.setattr(cache, "__version__", "different-format")
+    assert run_cached(source, directory)._cache_stats["scanned"] == normalized(
+        source
+    )
+
+    monkeypatch.setattr(
+        cache.importlib.metadata, "version", lambda name: "different-package"
+    )
+    assert run_cached(source, directory)._cache_stats["scanned"] == normalized(
+        source
+    )
+
+    analyzer = run_cached(
+        source, directory, cache_settings={"analysis_option": True}
+    )
+    assert analyzer._cache_stats["scanned"] == normalized(source)
+
+
+def test_deleted_files_are_removed(tmp_path):
+    source = tmp_path / "source"
+    source.mkdir()
+    a = source / "a.py"
+    b = source / "b.py"
+    a.write_text("value = 1\n", encoding="utf-8")
+    b.write_text("import a\n", encoding="utf-8")
+    directory = tmp_path / "cache"
+    run_cached(source, directory)
+
+    a.unlink()
+    analyzer = run_cached(source, directory)
+    assert analyzer._cache_stats["scanned"] == normalized(b)
+    document = json.loads(cache.get_cache_path(directory).read_bytes())
+    assert cache.normalize_path(a) not in document["modules"]
+
+
+def test_whitelist_changes_invalidate_importers(tmp_path, monkeypatch):
+    source = tmp_path / "module.py"
+    source.write_text(
+        "import example\n\ndef whitelisted_function(): pass\n",
+        encoding="utf-8",
+    )
+    directory = tmp_path / "cache"
+    whitelist = [b"whitelisted_function\n"]
+    original_get_data = cache.pkgutil.get_data
+
+    def get_data(package, resource):
+        if Path(resource).name == "example_whitelist.py":
+            return whitelist[0]
+        return original_get_data(package, resource)
+
+    monkeypatch.setattr(cache.pkgutil, "get_data", get_data)
+    run_cached(source, directory)
+    assert run_cached(source, directory)._cache_stats["reused"] == normalized(
+        source
+    )
+
+    whitelist[0] = b"another_function\n"
+    analyzer = run_cached(source, directory)
+    assert analyzer._cache_stats["scanned"] == normalized(source)
+    assert "whitelisted_function" in {
+        item.name for item in analyzer.get_unused_code()
+    }
+
+
+def test_interrupt_saves_completed_modules(tmp_path, monkeypatch):
+    source = tmp_path / "source"
+    source.mkdir()
+    a = source / "a.py"
+    b = source / "b.py"
+    a.write_text("first = 1\n", encoding="utf-8")
+    b.write_text("second = 2\n", encoding="utf-8")
+    directory = tmp_path / "cache"
+    original_scan = Vulture.scan
+
+    def interrupted_scan(self, code, filename=""):
+        if self._cache_session is None and Path(filename).name == "b.py":
+            raise KeyboardInterrupt
+        return original_scan(self, code, filename=filename)
+
+    monkeypatch.setattr(Vulture, "scan", interrupted_scan)
+    analyzer = Vulture(cache_dir=directory)
+    with pytest.raises(KeyboardInterrupt):
+        analyzer.scavenge([a, b])
+
+    path = cache.get_cache_path(directory)
+    document = json.loads(path.read_bytes())
+    assert cache.normalize_path(a) in document["modules"]
+    assert cache.normalize_path(b) not in document["modules"]
+    metadata = json.loads(path.with_name("cache.json.meta").read_bytes())
+    assert metadata["sha256"] == hashlib.sha256(path.read_bytes()).hexdigest()
+
+    monkeypatch.setattr(Vulture, "scan", original_scan)
+    analyzer = Vulture(cache_dir=directory)
+    analyzer.scavenge([a, b])
+    assert analyzer._cache_stats == {
+        "scanned": normalized(b),
+        "reused": normalized(a),
+    }
+
+
+def test_clear_removes_all_cache_contents(tmp_path):
+    directory = tmp_path / "cache"
+    nested = directory / "nested"
+    nested.mkdir(parents=True)
+    (nested / "old").write_text("old cache", encoding="utf-8")
+    (directory / "cache.json").write_text("invalid", encoding="utf-8")
+
+    cache.clear_cache(directory)
+
+    assert directory.is_dir()
+    assert list(directory.iterdir()) == []
