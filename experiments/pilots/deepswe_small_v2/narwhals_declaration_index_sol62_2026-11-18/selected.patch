+    ) -> Iterator[pa.ChunkedArray | None]:
+        offset = (window_size - 1) // 2 if center else 0
+        for i in range(len(self)):
+            stop = i + offset + 1
+            start = max(0, stop - window_size)
+            window = self.native.slice(start, stop - start)
