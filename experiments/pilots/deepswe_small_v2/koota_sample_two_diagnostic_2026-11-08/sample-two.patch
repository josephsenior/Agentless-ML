+import { afterEach, describe, expect, it } from 'vitest';
+import { createAspect, createWorld, Not, Or, relation, trait } from '../src';
+
+const worlds: ReturnType<typeof createWorld>[] = [];
+
+function makeWorld() {
+    const world = createWorld();
+    worlds.push(world);
+    return world;
+}
+
+afterEach(() => {
+    for (const world of worlds.splice(0)) world.destroy();
+});
+
+describe('aspects', () => {
+    it('creates distinct instances and flattens nested aspects', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Active = trait();
+        const Moving = createAspect(Position, Velocity);
+        const ActiveMoving = createAspect(Moving, Active);
+        const OtherMoving = createAspect(Position, Velocity);
+
+        expect(Moving).not.toBe(OtherMoving);
+        expect(Moving.id).not.toBe(OtherMoving.id);
+        expect(ActiveMoving.traits).toEqual([Position, Velocity, Active]);
+        expect(ActiveMoving.schema).toEqual({ x: 0, velocity: 0 });
+    });
+
+    it('rejects overlapping fields and relations', () => {
+        const Position = trait({ x: 0 });
+        const OtherPosition = trait({ x: 1 });
+        const RelatedTo = relation();
+
+        expect(() => createAspect(Position, OtherPosition)).toThrow(/overlap/i);
+        expect(() =>
+            createAspect(Position, RelatedTo as unknown as typeof OtherPosition)
+        ).toThrow(/relation/i);
+    });
+
+    it('adds only missing constituents and distributes initial values', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Moving = createAspect(Position, Velocity);
+        const world = makeWorld();
+        const entity = world.spawn(Position({ x: 10 }));
+
+        expect(entity.has(Moving)).toBe(false);
+        expect(entity.get(Moving)).toBeUndefined();
+
+        entity.add(Moving({ x: 99, velocity: 5 }));
+
+        expect(entity.has(Moving)).toBe(true);
+        expect(entity.get(Position)).toEqual({ x: 10 });
+        expect(entity.get(Velocity)).toEqual({ velocity: 5 });
+        expect(entity.get(Moving)).toEqual({ x: 10, velocity: 5 });
+
+        entity.remove(Moving);
+
+        expect(entity.has(Position)).toBe(false);
+        expect(entity.has(Velocity)).toBe(false);
+        expect(entity.get(Moving)).toBeUndefined();
+    });
+
+    it('supports aspects in spawn and world operations', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Moving = createAspect(Position, Velocity);
+        const world = makeWorld();
+        const entity = world.spawn(Moving({ x: 2, velocity: 3 }));
+
+        expect(entity.get(Moving)).toEqual({ x: 2, velocity: 3 });
+
+        world.add(Moving({ x: 4, velocity: 5 }));
+        expect(world.has(Moving)).toBe(true);
+        expect(world.get(Moving)).toEqual({ x: 4, velocity: 5 });
+
+        world.set(Moving, { velocity: 8 });
+        expect(world.get(Position)).toEqual({ x: 4 });
+        expect(world.get(Velocity)).toEqual({ velocity: 8 });
+
+        world.remove(Moving);
+        expect(world.has(Moving)).toBe(false);
+    });
+
+    it('requires every constituent and composes with Not and Or', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Selected = trait();
+        const Moving = createAspect(Position, Velocity);
+        const world = makeWorld();
+
+        const complete = world.spawn(Position, Velocity);
+        const partial = world.spawn(Position);
+        const selected = world.spawn(Selected);
+
+        expect([...world.query(Moving)]).toEqual([complete]);
+        expect([...world.query(Not(Moving))]).toEqual(
+            expect.arrayContaining([partial, selected])
+        );
+        expect([...world.query(Not(Moving))]).not.toContain(complete);
+        expect([...world.query(Or(Moving, Selected))]).toEqual(
+            expect.arrayContaining([complete, selected])
+        );
+        expect([...world.query(Or(Moving, Selected))]).not.toContain(partial);
+    });
+
+    it('merges readEach values and distributes updateEach writes', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Active = trait();
+        const Moving = createAspect(Position, Velocity);
+        const ActiveMoving = createAspect(Moving, Active);
+        const world = makeWorld();
+        const entity = world.spawn(ActiveMoving({ x: 2, velocity: 3 }));
+
+        world.query(ActiveMoving).readEach(([moving]) => {
+            expect(moving).toEqual({ x: 2, velocity: 3 });
+        });
+
+        world.query(ActiveMoving).updateEach(([moving]) => {
+            moving.x += moving.velocity;
+            moving.velocity = 7;
+        });
+
+        expect(entity.get(Position)).toEqual({ x: 5 });
+        expect(entity.get(Velocity)).toEqual({ velocity: 7 });
+
+        world.query(Position, Velocity).select(Moving).readEach(([moving]) => {
+            expect(moving).toEqual({ x: 5, velocity: 7 });
+        });
+    });
+
+    it('emits lifecycle hooks only at complete/incomplete transitions', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Moving = createAspect(Position, Velocity);
+        const world = makeWorld();
+        const added: number[] = [];
+        const removed: number[] = [];
+
+        world.onAdd(Moving, (entity) => added.push(entity));
+        world.onRemove(Moving, (entity) => removed.push(entity));
+
+        const entity = world.spawn(Position);
+        expect(added).toEqual([]);
+
+        entity.add(Velocity);
+        expect(added).toEqual([entity]);
+
+        entity.add(Moving);
+        expect(added).toEqual([entity]);
+
+        entity.remove(Position);
+        expect(removed).toEqual([entity]);
+
+        entity.remove(Velocity);
+        expect(removed).toEqual([entity]);
+
+        entity.add(Moving);
+        expect(added).toEqual([entity, entity]);
+    });
+
+    it('detects changes per constituent and emits aspect changes only while complete', () => {
+        const Position = trait({ x: 0 });
+        const Velocity = trait({ velocity: 0 });
+        const Moving = createAspect(Position, Velocity);
+        const world = makeWorld();
+        const entity = world.spawn(Moving);
+        let positionChanges = 0;
+        let velocityChanges = 0;
+        let aspectChanges = 0;
+
+        world.onChange(Position, () => positionChanges++);
+        world.onChange(Velocity, () => velocityChanges++);
+        world.onChange(Moving, () => aspectChanges++);
+
+        entity.set(Moving, { x: 4 });
+
+        expect(positionChanges).toBe(1);
+        expect(velocityChanges).toBe(0);
+        expect(aspectChanges).toBe(1);
+
+        world.query(Moving).updateEach(([moving]) => {
+            moving.velocity = 6;
+        });
+
+        expect(positionChanges).toBe(1);
+        expect(velocityChanges).toBe(1);
+        expect(aspectChanges).toBe(2);
+
+        entity.remove(Velocity);
+        entity.set(Position, { x: 8 });
+
+        expect(positionChanges).toBe(2);
+        expect(aspectChanges).toBe(2);
+    });
+
+    it('supports tag-only aspects', () => {
+        const Active = trait();
+        const Visible = trait();
+        const ActiveVisible = createAspect(Active, Visible);
+        const world = makeWorld();
+        const entity = world.spawn(ActiveVisible);
+
+        expect(entity.has(ActiveVisible)).toBe(true);
+        expect(entity.get(ActiveVisible)).toEqual({});
+
+        world.query(ActiveVisible).readEach(([value]) => {
+            expect(value).toEqual({});
+        });
+
+        entity.remove(Visible);
+        expect(entity.has(ActiveVisible)).toBe(false);
+    });
+});
