+func TestHTMLDocumentNormalization(t *testing.T) {
+	root := parseHTMLDocument(`<!DOCTYPE html><!-- ignored --><P CLASS="a" hidden>Hello &amp; &#65;&#x42;</P><br><img SRC="x">`)
+	got := map[string]any{
+		"head": simpleHTMLValue(root.children[0]),
+		"body": simpleHTMLValue(root.children[1]),
+	}
+	want := map[string]any{
+		"head": "",
+		"body": map[string]any{
+			"p": map[string]any{
+				"-class":  "a",
+				"-hidden": "",
+				"#text":   "Hello & AB",
+			},
+			"br": "",
+			"img": map[string]any{
+				"-src": "x",
+			},
+		},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("got %#v; want %#v", got, want)
+	}
+}
+
+func TestHTMLImplicitClosures(t *testing.T) {
+	tests := []struct {
+		name  string
+		input string
+		want  any
+	}{
+		{
+			name:  "paragraphs and block elements",
+			input: `<p>one<div>box</div><p>two<p>three`,
+			want: map[string]any{
+				"p":   []any{"one", "two", "three"},
+				"div": "box",
+			},
+		},
+		{
+			name:  "list items",
+			input: `<ul><li>one<li>two</ul>`,
+			want: map[string]any{
+				"ul": map[string]any{"li": []any{"one", "two"}},
+			},
+		},
+		{
+			name:  "nested lists retain their parent item",
+			input: `<ul><li>one<ul><li>nested</ul><li>two</ul>`,
+			want: map[string]any{
+				"ul": map[string]any{
+					"li": []any{
+						map[string]any{
+							"#text": "one",
+							"ul":    map[string]any{"li": "nested"},
+						},
+						"two",
+					},
+				},
+			},
+		},
+		{
+			name:  "definition items",
+			input: `<dl><dt>term<dd>definition<dt>next</dl>`,
+			want: map[string]any{
+				"dl": map[string]any{
+					"dt": []any{"term", "next"},
+					"dd": "definition",
+				},
+			},
+		},
+		{
+			name:  "table cells and rows",
+			input: `<table><tr><td>a<td>b<tr><td>c</table>`,
+			want: map[string]any{
+				"table": map[string]any{
+					"tr": []any{
+						map[string]any{"td": []any{"a", "b"}},
+						map[string]any{"td": "c"},
+					},
+				},
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			root := parseHTMLDocument(test.input)
+			got := simpleHTMLValue(root.children[1])
+			if !reflect.DeepEqual(got, test.want) {
+				t.Fatalf("got %#v; want %#v", got, test.want)
+			}
+		})
+	}
+}
+
+func TestHTMLStructuredDocument(t *testing.T) {
+	root := parseHTMLDocument(`<HTML LANG="en"><HEAD><title>Title</title></HEAD><BODY><p id="x">Text</p></BODY></HTML>`)
+	got := structuredHTMLValue(root)
+	if got["tag"] != "html" {
+		t.Fatalf("unexpected root tag: %#v", got["tag"])
+	}
+	if !reflect.DeepEqual(got["attrs"], map[string]any{"lang": "en"}) {
+		t.Fatalf("unexpected root attributes: %#v", got["attrs"])
+	}
+	children := got["children"].([]any)
+	if len(children) != 2 {
+		t.Fatalf("expected head and body, got %#v", children)
+	}
+	if children[0].(map[string]any)["tag"] != "head" ||
+		children[1].(map[string]any)["tag"] != "body" {
+		t.Fatalf("unexpected normalized children: %#v", children)
+	}
+}
+
+func TestHTMLRawText(t *testing.T) {
+	const script = "\nif (a < b && c > d) { x = '&amp;'; }\n"
+	root := parseHTMLDocument("<script>" + script + "</SCRIPT>")
+	body := simpleHTMLValue(root.children[1]).(map[string]any)
+	if body["script"] != script {
+		t.Fatalf("raw text changed: got %q; want %q", body["script"], script)
+	}
+
+	nodes, err := htmlNodesFromMap(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	renderHTMLNode(&output, nodes[0], 0, "  ", true, false)
+	if want := "<script>" + script + "</script>"; output.String() != want {
+		t.Fatalf("got %q; want %q", output.String(), want)
+	}
+}
+
+func TestHTMLRendering(t *testing.T) {
+	nodes, err := htmlNodesFromMap(map[string]any{
+		"DIV": map[string]any{
+			"-TITLE": `"A" & 'B'`,
+			"#text":  "<hello>",
+			"br":     "",
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	renderHTMLNode(&output, nodes[0], 0, "  ", true, false)
+	want := `<div title="&quot;A&quot; &amp; &apos;B&apos;">&lt;hello&gt;<br/></div>`
+	if output.String() != want {
+		t.Fatalf("got %q; want %q", output.String(), want)
+	}
+}
+
+func TestHTMLPrettyAndCompactRendering(t *testing.T) {
+	nodes, err := htmlNodesFromMap(map[string]any{
+		"div": map[string]any{
+			"p": []any{"one", "two"},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		compact bool
+		want    string
+	}{
+		{compact: true, want: "<div><p>one</p><p>two</p></div>"},
+		{compact: false, want: "<div>\n  <p>one</p>\n  <p>two</p>\n</div>"},
+	}
+	for _, test := range tests {
+		var output bytes.Buffer
+		renderHTMLNode(&output, nodes[0], 0, "  ", test.compact, false)
+		if output.String() != test.want {
+			t.Fatalf("compact=%v: got %q; want %q", test.compact, output.String(), test.want)
+		}
+	}
+}
