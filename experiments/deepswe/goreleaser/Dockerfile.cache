ARG PARENT=public.ecr.aws/d3j8x8q7/swe-bench-202605:kh7cc4hqw7wb87h3kwwnkq0pv1830gjz-v1.1@sha256:778c43a00bb317e8e0b266b212b187be7765a12dbdadde3ba2f4bceba9c40080
FROM ${PARENT}
LABEL org.agentless-ml.condition="goreleaser-relocated-cache-diagnostic"
# Move only existing environment caches. Do not build or copy candidate code.
RUN set -eu; \
    test -x /tmp/gomodcache/golang.org/toolchain@v0.0.1-go1.26.1.linux-amd64/bin/go; \
    mkdir -p /opt/agentless-go; \
    mv /tmp/gomodcache /opt/agentless-go/modules; \
    mv /tmp/gocache /opt/agentless-go/build-seed
ENV GOMODCACHE=/opt/agentless-go/modules \
    GOPROXY=off \
    GOTOOLCHAIN=local \
    PATH=/opt/agentless-go/modules/golang.org/toolchain@v0.0.1-go1.26.1.linux-amd64/bin:${PATH}
RUN test "$(go version)" = "go version go1.26.1 linux/amd64"
